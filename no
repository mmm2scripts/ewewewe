----------------------------------------------------------------------
-- auto-accept incoming trade requests (only the request pop-up; switch in CONFIG > TRADE REQUESTS)
----------------------------------------------------------------------

do
	local function dig(root, ...)
		for _, n in ipairs({ ... }) do
			root = root and root:FindFirstChild(n)
		end
		return root
	end

	local function findAccept(root)
		if root:IsA("GuiButton") then
			return root
		end
		local fallback
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("GuiButton") then
				local t = d:IsA("TextButton") and d.Text:lower() or ""
				if d.Name:lower():find("accept") or t:find("accept") then
					return d
				end
			end
		end
		return nil
	end

	local function press(btn)
		local fired = false
		pcall(function()
			for _, sig in ipairs({ btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.MouseButton1Up }) do
				for _, c in ipairs(getconnections(sig)) do
					pcall(function() c:Fire() end)
					fired = true
				end
			end
		end)
	end

	H.pressButton = press

	task.spawn(function()
		local pg = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
		local handled = false
		while gui.Parent do
			task.wait(0.1)
			pcall(function()
				local req = dig(pg, "MainGUI", "Game", "Leaderboard", "Container", "TradeRequest", "ReceivingRequest")
				if (SETTINGS.autoAccept or H.beg.running) and req and req.Visible then
					if not handled then
						handled = true
						task.wait(0.1)
						local btn = findAccept(req)
						if btn then
							local who = dig(req, "Username")
							log("Auto-accepting trade from " .. tostring(who and who.Text or "?"))
							press(btn)
						else
							log("Auto-accept: no button found under ReceivingRequest")
						end
					end
				else
					handled = false
				end
			end)
		end
	end)
end

----------------------------------------------------------------------
-- beg bot: walk to a person, ask in chat ONCE, accept their trade, wait, next person
----------------------------------------------------------------------

do
	local B = H.beg
	local TextChatService = game:GetService("TextChatService")
	local TeleportService = game:GetService("TeleportService")
	local ACCEPT_CODE = 285646582   -- argument MM2's Trade.AcceptTrade remote expects (accept + confirm)

	local DEFAULT_MSGS = { "a little kindness goes a long way 🥺 could you spare a small free weapon? ❤️" }

	local function messages()
		local list = {}
		for line in tostring(SETTINGS.begMsgs):gmatch("[^\r\n]+") do
			line = line:match("^%s*(.-)%s*$")
			if line ~= "" then
				list[#list + 1] = line
			end
		end
		if #list == 0 then
			list = DEFAULT_MSGS
		end
		return list
	end

	local function rawSay(msg)
		local ok = pcall(function()
			if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
				error("legacy chat")
			end
			local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if not ch then
				error("no general channel")
			end
			ch:SendAsync(msg)
		end)
		if ok then
			return true
		end
		return (pcall(function()
			local ev = RS:WaitForChild("DefaultChatSystemChatEvents", 2)
			ev.SayMessageRequest:FireServer(msg, "All")
		end))
	end

	-- SPAM GUARD: global gap of 4-7 s between any two chat messages, at most 6 per minute,
	-- and the same wording is never used twice in a row. Chat is never sent while BEG is stopped.
	local lastSay, sentTimes, lastMsg = -1e9, {}, nil
	local function say(msg)
		local gap = 4 + math.random() * 3
		while B.running and gui.Parent and os.clock() - lastSay < gap do
			B.setStatus("spam guard: short pause between messages")
			task.wait(0.5)
		end
		while B.running and gui.Parent do
			local now, keep = os.clock(), {}
			for _, t in ipairs(sentTimes) do
				if now - t < 60 then
					keep[#keep + 1] = t
				end
			end
			sentTimes = keep
			if #sentTimes < 6 then
				break
			end
			B.setStatus("spam guard: message limit reached, waiting")
			task.wait(1)
		end
		if not (B.running and gui.Parent) then
			return false
		end
		lastSay = os.clock()
		sentTimes[#sentTimes + 1] = lastSay
		return rawSay(msg)
	end

	local function pickMsg(list)
		if #list <= 1 then
			return list[1]
		end
		local m
		repeat
			m = list[math.random(#list)]
		until m ~= lastMsg
		lastMsg = m
		return m
	end

	local function parts(plr)
		local c = plr and plr.Character
		if not c then
			return nil
		end
		local hrp = c:FindFirstChild("HumanoidRootPart")
		local hum = c:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			return hrp, hum
		end
		return nil
	end

	local function pickTarget()
		local myHrp = parts(LocalPlayer)
		if not myHrp then
			return nil
		end
		local best, bestD = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and not B.done[p.UserId] then
				local hrp = parts(p)
				if hrp then
					local d = (hrp.Position - myHrp.Position).Magnitude
					if d < bestD then
						best, bestD = p, d
					end
				end
			end
		end
		return best
	end

	-- the open trade (if any), read straight from the game so it works on every tab / with the window hidden
	-- fast "a trade is opening" signal: the trade GUI showing, or any Trade remote event in the last 3 s.
	-- while it is hot the loops poll much faster so the accept starts the moment the trade opens.
	B.lastEvt = -1e9
	for _, r in ipairs(Trade:GetChildren()) do
		if r:IsA("RemoteEvent") then
			track(r.OnClientEvent:Connect(function()
				B.lastEvt = os.clock()
			end))
		end
	end
	local function tradeHot()
		if os.clock() - B.lastEvt < 3 then
			return true
		end
		local g = PlayerGui:FindFirstChild("TradeGUI")
		if g and g:IsA("ScreenGui") and g.Enabled then
			local c = g:FindFirstChild("Container")
			return c == nil or (c:IsA("GuiObject") and c.Visible)
		end
		return false
	end

	local function peekTrade()
		local _, _, packed = getStatus()
		if not packed then
			return nil
		end
		for i = 2, (packed.n or 0) do
			if type(packed[i]) == "table" then
				local sides = findSides(packed[i])
				if sides then
					return sides
				end
			end
		end
		return nil
	end

	-- PlayerGui.TradeGUI.Container.Trade.Actions.Accept
	--   .Cooldown  (visible while the button is locked)
	--   .Confirm   (visible on the second stage)
	--   .Cancel    (never pressed by this bot)
	local function tradeAcceptRoot()
		local n = LocalPlayer:FindFirstChild("PlayerGui")
		for _, name in ipairs({ "TradeGUI", "Container", "Trade", "Actions", "Accept" }) do
			n = n and n:FindFirstChild(name)
		end
		return n
	end

	local function isCancel(d)
		return d.Name:lower():find("cancel") ~= nil
			or (d:IsA("TextButton") and d.Text:lower():find("cancel") ~= nil)
	end

	local function isShown(o)
		return o ~= nil and o:IsA("GuiObject") and o.Visible
	end

	-- Accept.Cooldown visible = the button is locked, don't press yet
	local function onCooldown(root)
		return root ~= nil and isShown(root:FindFirstChild("Cooldown"))
	end

	-- Accept.Confirm visible = second stage
	local function confirmShown(root)
		return root ~= nil and isShown(root:FindFirstChild("Confirm"))
	end

	-- the clickable thing for an object: itself if it is a button, else the first non-cancel button inside it
	local function clickable(obj)
		if obj:IsA("GuiButton") then
			return obj
		end
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("GuiButton") and not isCancel(d) then
				local n = d.Name:lower()
				local t = d:IsA("TextButton") and d.Text:lower() or ""
				if n:find("accept") or n:find("confirm") or t:find("accept") or t:find("confirm") then
					return d
				end
			end
		end
		return obj
	end

	-- presses ONLY the given Accept / Confirm button by firing its own click handlers.
	-- no mouse movement, no simulated screen clicks, no fake input events, nothing else on screen is touched
	-- and our own window is never hidden or moved.
	local function clickGui(obj)
		local fired = 0
		pcall(function()
			if obj:IsA("GuiButton") then
				for _, sig in ipairs({ obj.MouseButton1Down, obj.MouseButton1Up, obj.MouseButton1Click, obj.Activated }) do
					for _, c in ipairs(getconnections(sig)) do
						pcall(function() c:Fire() end)
						fired = fired + 1
					end
				end
			end
		end)
		return fired
	end

	-- the live trade: status string ("None" when no trade) + the table that carries LastOffer
	local function liveTrade()
		local _, _, packed = getStatus()
		if not packed or not packed[1] then
			return nil, nil
		end
		local status = packed[2]
		local data
		for i = 2, (packed.n or 0) do
			local v = packed[i]
			if type(v) == "table" then
				if v.LastOffer ~= nil then
					data = v
					break
				end
				for _, v2 in pairs(v) do
					if type(v2) == "table" and v2.LastOffer ~= nil then
						data = v2
						break
					end
				end
				if data then
					break
				end
			end
		end
		return status, data
	end

	-- accepts the way the game does: Trade.AcceptTrade:FireServer(PlaceId * 3, LastOffer)
	-- (LastOffer changes whenever either side edits the trade, so it is read fresh on every press).
	-- falls back to the Accept / Confirm button's own click handlers only if LastOffer cannot be found.
	local function fireAccept()
		local status, data = liveTrade()
		if status == "None" then
			return false
		end
		local r = Trade:FindFirstChild("AcceptTrade")
		if r and data and data.LastOffer ~= nil then
			local ok, err = pcall(function()
				r:FireServer(game.PlaceId * 3, data.LastOffer)
			end)
			if not ok then
				log("Beg: AcceptTrade failed: " .. tostring(err))
			end
			return ok
		end

		local root = tradeAcceptRoot()
		if root and not onCooldown(root) then
			local target = confirmShown(root) and root:FindFirstChild("Confirm") or root
			local btn = clickable(target)
			local n = clickGui(btn)
			log(string.format("Beg: pressed %s \"%s\" (%d handlers)", btn.ClassName, btn.Name, n))
			return n > 0
		end
		return false
	end

	-- Accept -> wait for Confirm -> Confirm. Re-presses if they change their offer.
	local function acceptSequence()
		B.setStatus("trade open - accepting")
		local fires, lastFire, t0 = 0, 0, os.clock()
		local lastList = {}   -- the newest offer we saw before the trade closed (they may add more items while we accept)
		while B.running and gui.Parent and os.clock() - t0 < 40 do
			local sides = peekTrade()
			if not sides then
				break
			end
			local cur = decodeOffer(sides.theirs)
			if #cur > 0 then
				lastList = cur
			end
			if #cur > 0 and fires < 60 then
				local root = tradeAcceptRoot()
				local since = os.clock() - lastFire
				local stageConfirm = confirmShown(root)
				-- press when: first time, or ~1.2 s since the last press (covers Confirm appearing / offer changes)
				local due = fires == 0 or since >= 0.5
				if due and fireAccept() then
					fires = fires + 1
					lastFire = os.clock()
					B.setStatus(stageConfirm and "pressed Confirm" or "pressed Accept")
				end
			end
			task.wait(0.12)
		end
		return fires > 0, lastList
	end

	local function waitCooldown()
		local t0 = os.clock()
		while B.running and gui.Parent do
			local left = SETTINGS.begCool - (os.clock() - t0)
			if left <= 0 then
				break
			end
			B.setStatus(string.format("trade accepted - moving on in %d s", math.ceil(left)))
			task.wait(0.5)
		end
	end

	------------------------------------------------------------------
	-- random server hop WITHOUT any lookup. No HTTP, no games API, no server ids:
	-- Roblox's own matchmaking drops the player into a random public server with
	-- room, so the only thing we control is the timing - and it is random on purpose:
	--   * a random wait in begHopMin..begHopMax before every hop (plus jitter)
	--   * a hard random minimum gap between teleport attempts
	--   * random growing backoff after a failure (capped, still random)
	-- that keeps us far away from Roblox's teleport throttle ("too many teleports",
	-- HTTP 429 on the teleport, and the blank "disconnected" screen).
	------------------------------------------------------------------

	local HOP_MIN_GAP = 45   -- hard floor between teleport attempts, plus a random 0-30 s

	local Hop = { busy = false, nextAt = 0, lastHop = -1e9, hops = 0, fails = 0 }

	-- random float in [a, b]; the range is sorted first so MIN / MAX can be set in any order
	local function randBetween(a, b)
		if b < a then
			a, b = b, a
		end
		return a + math.random() * (b - a)
	end

	-- blind teleport: matchmaking picks a random public server. no id, no request.
	local function hopRandom()
		if Hop.busy then
			return false, "a hop is already running"
		end

		-- random minimum gap between attempts, even if the UI timers are set very low
		local gap = HOP_MIN_GAP + math.random() * 30
		local since = os.clock() - Hop.lastHop
		if since < gap then
			return false, string.format("teleport cooldown %.0f s left", gap - since)
		end

		Hop.busy = true
		Hop.lastHop = os.clock()

		-- keep-on: queue the script again for the next server when the executor allows it
		if not H.queueReload() and SETTINGS.autoLoad then
			log("Auto load: nothing queued (set a script URL / command in the BEG tab or save mm2_trade_watcher_script.lua)")
		end

		-- tiny random jitter, then the blind teleport
		task.wait(0.25 + math.random() * 1.75)
		local ok = pcall(function()
			TeleportService:Teleport(game.PlaceId, LocalPlayer)
		end)
		local why = ok and "random server (matchmaking)" or "teleport failed"

		if not ok then
			-- one blind retry after a random pause - still no lookup of any kind
			task.wait(2 + math.random() * 4)
			ok = pcall(function()
				TeleportService:TeleportAsync(game.PlaceId, { LocalPlayer })
			end)
			why = ok and "random server (async)" or "teleport failed"
		end

		if ok then
			Hop.hops = Hop.hops + 1
			Hop.fails = 0
			B.hops = (B.hops or 0) + 1
			B.paint()
			H.sendHook("Server hop",
				string.format("Moved to a new random server.\nAccount: **%s**\nHops this session: **%d**",
					MY_NAME, B.hops or 0), 3899126)
		else
			Hop.fails = Hop.fails + 1
			-- random backoff that grows with repeated failures (capped so it keeps trying)
			local backoff = math.min(30 + 15 * Hop.fails, 150) + math.random() * 30
			Hop.nextAt = os.clock() + backoff
			why = why .. string.format(" - retrying in %d s", math.ceil(backoff))
		end
		Hop.busy = false
		return ok, why
	end

	-- TEST HOP button: one immediate blind hop, still subject to the random minimum gap
	H.testHopAction = function()
		local ok, why = hopRandom()
		return ok, why
	end
	-- smooth glide to the spot 5 studs in front of a player, looking at them.
	-- runs every frame: accelerates, eases out near the spot, tracks a moving target and turns smoothly.
	local RunService = game:GetService("RunService")
	local function frontGoal(hrp)
		local pos = hrp.Position + hrp.CFrame.LookVector * 5
		return pos, Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z)
	end

	local function glide(myHrp, p, maxT)
		local t0, lastPeek = os.clock(), 0
		while B.running and gui.Parent and p.Parent and os.clock() - t0 < maxT do
			local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
			local hrp = parts(p)
			if not (hrp and myHrp.Parent) then
				return "lost"
			end
			local goalPos, faceDir = frontGoal(hrp)
			local cur = myHrp.CFrame
			local dist = (goalPos - cur.Position).Magnitude
			if dist < 0.3 then
				myHrp.CFrame = CFrame.lookAt(goalPos, goalPos + (faceDir.Magnitude > 0.01 and faceDir or cur.LookVector))
				return "arrived"
			end
			-- speed: ramps up from 25 to 160 studs/s, and never overshoots (eases out proportionally to the distance)
			local cap = math.min(160, 25 + (os.clock() - t0) * 260)
			local step = math.min(dist * (1 - math.exp(-9 * dt)), cap * dt)
			step = math.max(step, math.min(dist, 5 * dt))
			local pos = cur.Position:Lerp(goalPos, step / dist)
			local want = faceDir.Magnitude > 0.01 and faceDir.Unit or cur.LookVector
			local look = cur.LookVector:Lerp(want, 1 - math.exp(-12 * dt))
			look = Vector3.new(look.X, 0, look.Z)
			if look.Magnitude < 0.01 then
				look = want
			end
			myHrp.CFrame = CFrame.lookAt(pos, pos + look)
			myHrp.AssemblyLinearVelocity = Vector3.zero
			if os.clock() - lastPeek > 0.25 then
				lastPeek = os.clock()
				if tradeHot() and peekTrade() then
					return "trade"   -- a trade opened mid-move: stop gliding and handle it
				end
			end
		end
		return "timeout"
	end

	local function runTargetInner(p)
		B.target = p
		B.paint()
		local msgs = messages()
		local startT, arrivedT = os.clock(), nil
		local asked, tries = false, 0   -- ONE message per person
		local wasOpen, declines = false, 0

		-- inventory BEFORE the trade (read in the background while we message / walk over). Used afterwards to
		-- confirm the items really arrived. nil = could not be read, then the trade is trusted as before.
		-- the baseline only counts when it was read BEFORE we first pressed accept (inventory unchanged then)
		local base, acceptT
		task.spawn(function()
			local ok, m, rep = pcall(H.detectInventory)
			if ok and m and rep and not rep.guiOnly and not acceptT then
				base = m
			end
		end)

		while B.running and gui.Parent do
			if not p.Parent then
				return "left the game"
			end

			-- 0) message for THIS person, sent right away (before walking over): exactly one per person,
			--    addressed to them by name, only retried (max 3) if sending itself failed
			if not asked and tries < 3 then
				tries = tries + 1
				B.setStatus("messaging " .. p.DisplayName)
				if say(p.DisplayName .. ", " .. pickMsg(msgs)) then
					asked = true
				end
			end

			-- 1) someone offered us something? accept it
			local sides = peekTrade()
			-- a trade opened and closed again with nothing taken (they declined / cancelled with no weapon):
			-- stay with them and wait for their next trade request pop-up (fresh wait, max 3 times)
			if sides then
				wasOpen = true
			elseif wasOpen then
				wasOpen = false
				declines = declines + 1
				if declines <= 3 and arrivedT then
					arrivedT = os.clock()
					B.setStatus(string.format("%s declined - waiting for another trade request", p.DisplayName))
					log("Beg: " .. p.Name .. " declined with no weapon - waiting for another request (" .. declines .. "/3)")
				end
			end
			local gotList = sides and decodeOffer(sides.theirs) or {}
			if sides and #gotList > 0 then
				acceptT = acceptT or os.clock()
				local accepted, finalList = acceptSequence()
				if accepted then
					if finalList and #finalList >= #gotList then
						gotList = finalList
					end
					-- the trade is over: did the items really land in our inventory?
					-- per item: owned count now > count before.  fallback: total owned count went up by the offered amount.
					if base then
						B.setStatus("trade closed - checking inventory...")
						local want = {}
						local offeredTotal = 0
						for _, it in ipairs(gotList) do
							want[it.dataID] = it
							offeredTotal = offeredTotal + it.qty
						end
						local baseTotal = 0
						for _, n in pairs(base) do
							baseTotal = baseTotal + n
						end

						local confirmed, unreadable = {}, false
						local allOk = false
						for attempt = 1, 4 do
							task.wait(1.5 + attempt)   -- 2.5 s, 3.5 s, 4.5 s, 5.5 s: the inventory can lag behind the trade
							if not (B.running and gui.Parent) then
								break
							end
							local ok, m, rep = pcall(H.detectInventory)
							if not (ok and m and rep and not rep.guiOnly) then
								unreadable = true
								break
							end
							confirmed = {}
							local nConf, nowTotal = 0, 0
							for id, it in pairs(want) do
								if (m[id] or 0) > (base[id] or 0) then
									confirmed[id] = it
									nConf = nConf + 1
								end
							end
							for _, n in pairs(m) do
								nowTotal = nowTotal + n
							end
							local nWant = 0
							for _ in pairs(want) do
								nWant = nWant + 1
							end
							if nConf == nWant then
								allOk = true
							elseif nConf == 0 and nowTotal >= baseTotal + offeredTotal then
								-- ids differ between trade and inventory but the owned total went up: accept that
								allOk = true
								confirmed = want
							end
							if allOk or nConf > 0 and attempt >= 3 then
								break
							end
						end

						if unreadable then
							log("Beg: inventory unreadable after the trade - trusting the trade")
						elseif not allOk and next(confirmed) == nil then
							log("Beg: trade with " .. tostring(sides.theirName) .. " finished but the items are NOT in the inventory - continuing to beg")
							B.setStatus("items not received - continuing to beg")
							return "trade failed (items not received)"
						elseif not allOk then
							-- some of the items arrived: only those are reported
							local rebuilt = {}
							for _, it in ipairs(gotList) do
								if confirmed[it.dataID] then
									rebuilt[#rebuilt + 1] = it
								end
							end
							log(string.format("Beg: only %d of %d offered items found in the inventory", #rebuilt, #gotList))
							gotList = rebuilt
						end
					end
					B.accepted = B.accepted + 1
					B.paint()
					log("Beg: accepted a trade (" .. tostring(sides.theirName) .. ") - items confirmed in inventory")
					H.sendHook("Trade accepted",
						string.format("Accepted a trade from **%s**.\nAccount: **%s**\nAccepted this session: **%d**\n\n**Items received:**\n%s",
							tostring(sides.theirName or "?"), MY_NAME, B.accepted, H.itemLines(gotList)), 3899126)
					if not SETTINGS.begHopTrade then
						waitCooldown()
					end
					return "traded"
				end
			end

			-- 2) walk to / follow the person
			local myHrp, myHum = parts(LocalPlayer)
			local hrp = parts(p)
			if not (myHrp and myHum and hrp) then
				return "lost them"
			end
			-- LOCK the avatar: anchored (and no walking) for as long as we work on this person
			myHrp.Anchored = true
			myHum.WalkSpeed = 0
			myHum.JumpPower = 0
			pcall(function() myHum.JumpHeight = 0 end)

			-- stand 5 studs IN FRONT of them, looking at them (smooth per-frame glide, never a snap)
			local goalPos = frontGoal(hrp)
			local dist = (myHrp.Position - goalPos).Magnitude
			if dist > 1.5 then
				B.setStatus(string.format("moving to %s", p.DisplayName))
				glide(myHrp, p, 3)
				if os.clock() - startT > 30 and not arrivedT then
					return "could not reach"
				end
			else
				arrivedT = arrivedT or os.clock()
				-- keep looking at them (gentle turn, position unchanged)
				pcall(function()
					local face = CFrame.lookAt(myHrp.Position, Vector3.new(hrp.Position.X, myHrp.Position.Y, hrp.Position.Z))
					myHrp.CFrame = myHrp.CFrame:Lerp(face, 0.45)
				end)
				local left = SETTINGS.begWait - (os.clock() - arrivedT)
				B.setStatus(string.format("asking %s  ·  %d s left", p.DisplayName, math.max(0, math.ceil(left))))
				if left <= 0 then
					return "no trade"
				end
			end
			task.wait(tradeHot() and 0.1 or 0.3)
		end
		return "stopped"
	end

	-- always release the avatar when we are done with a person (also on stop / errors)
	local function unlockAvatar()
		pcall(function()
			local hrp, hum = parts(LocalPlayer)
			if hrp then
				hrp.Anchored = false
			end
			if hum then
				hum.WalkSpeed = B.savedWalk or 16
				hum.JumpPower = B.savedJump or 50
				pcall(function() hum.JumpHeight = B.savedHeight or 7.2 end)
			end
		end)
	end

	local function runTarget(p)
		pcall(function()
			local _, hum = parts(LocalPlayer)
			if hum and hum.WalkSpeed > 0 then
				B.savedWalk, B.savedJump = hum.WalkSpeed, hum.JumpPower
				B.savedHeight = hum.JumpHeight
			end
		end)
		local ok, res = pcall(runTargetInner, p)
		unlockAvatar()
		if not ok then
			log("Beg: error - " .. tostring(res))
			return "error"
		end
		return res
	end

	task.spawn(function()
		local noneSince
		while gui.Parent do
			task.wait(0.5)
			if B.running then
				local p = pickTarget()
				if p then
					noneSince = nil
					B.done[p.UserId] = true
					B.asked = B.asked + 1
					local why = runTarget(p)
					log("Beg: finished with " .. p.Name .. " (" .. tostring(why) .. ")")
					B.target = nil
					B.paint()
					if why == "traded" and SETTINGS.begHopTrade then
						-- one trade done: leave for a new random server (retry until the teleport starts)
						while B.running and gui.Parent do
							B.setStatus("trade done - hopping to a new server...")
							local ok, hwhy = hopRandom()
							log("Hop after trade: " .. tostring(hwhy))
							if ok then
								B.done = {}
								noneSince = nil
								task.wait(5)
								break
							end
							local wait = 5 + math.random() * 10
							local t0 = os.clock()
							while B.running and gui.Parent and os.clock() - t0 < wait do
								B.setStatus("hop: " .. tostring(hwhy))
								task.wait(0.5)
							end
						end
					end
				else
					noneSince = noneSince or os.clock()
					if next(B.done) and SETTINGS.begHop then
						-- everyone here was asked once: leave for a new random server (retry until it starts)
						B.setStatus("everyone asked - hopping to a new server...")
						local ok, hwhy = hopRandom()
						log("Hop (everyone asked): " .. tostring(hwhy))
						if ok then
							B.done = {}
							noneSince = nil
							task.wait(5)
						else
							local wait = 5 + math.random() * 10
							local t0 = os.clock()
							while B.running and gui.Parent and os.clock() - t0 < wait do
								B.setStatus("hop: " .. tostring(hwhy))
								task.wait(0.5)
							end
						end
					else
						B.setStatus("no one to ask - looking again")
						-- with HOP off: start over only after a long quiet minute (never spams the same person quickly)
						if os.clock() - noneSince > 120 and next(B.done) then
							B.done = {}
							noneSince = nil
						end
					end
					task.wait(4)
				end
			end
		end
	end)
end

