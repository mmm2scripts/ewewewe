	local meta = WeaponsDB[dataID]
	if type(meta) ~= "table" then
		return tostring(dataID), "Other"
	end
	local name = meta.ItemName or meta.Name or tostring(dataID)
	if meta.Chroma == true and not name:lower():find("^chroma") then
		name = "Chroma " .. name
	end
	return name, meta.Rarity or "Other"
end

-- name -> game id, ONLY when exactly one game item carries that name (shared names are never resolved)
local idByKey
local function getIdByKey()
	if idByKey then
		return idByKey
	end
	idByKey = {}
	local ambiguous = {}
	for id, meta in pairs(WeaponsDB) do
		if type(meta) == "table" then
			local nm = itemLabel(id)
			local k = normKey(nm)
			if idByKey[k] == nil and not ambiguous[k] then
				idByKey[k] = id
			elseif idByKey[k] ~= id then
				ambiguous[k] = true
				idByKey[k] = nil
			end
		end
	end
	return idByKey
end

-- explicit event of an item: from its id text, or from a text field of its metadata
function H.idEvent(dataID)
	local ev = H.eventFromText(tostring(dataID))
	if ev then
		return ev
	end
	local meta = WeaponsDB[dataID]
	if type(meta) == "table" then
		for _, key in ipairs({ "Event", "Season", "Holiday" }) do
			ev = H.eventFromText(meta[key])
			if ev then
				return ev
			end
		end
	end
	return nil
end

-- "knife" / "gun": the explicit id text first, then the game metadata. nil when neither says.
function H.weaponKind(dataID)
	local k = H.idKind(tostring(dataID))
	if k then
		return k
	end
	local meta = dataID and WeaponsDB[dataID]
	if type(meta) ~= "table" then
		return nil
	end
	local t = tostring(meta.ItemType or meta.Type or meta.WeaponType or ""):lower()
	if t:find("knife", 1, true) then
		return "knife"
	end
	if t:find("gun", 1, true) then
		return "gun"
	end
	return nil
end

-- a game id is only valid when it is in the weapon database (or, if the database failed to load, any string)
function H.knownId(id)
	if type(id) ~= "string" then
		return false
	end
	if next(WeaponsDB) == nil then
		return id ~= ""
	end
	return WeaponsDB[id] ~= nil
end

H.IMAGE_KEYS = {
	"ItemImage", "ImageId", "ItemImageId", "Image", "ImageID",
	"Icon", "IconId", "Thumbnail", "Texture", "TextureId", "AssetId", "AssetID",
}
H.IMAGE_PATTERNS = { "image", "icon", "thumb", "texture", "decal" }

function H.assetIdFrom(v)
	if type(v) == "number" and v > 1000 then
		return math.floor(v)
	end
	if type(v) == "string" then
		local id = v:match("rbxassetid://(%d+)")
			or v:match("[?&][iI][dD]=(%d+)")
			or v:match("^(%d%d%d%d+)$")
		return tonumber(id)
	end
	return nil
end

function H.metaImageId(meta)
	for _, key in ipairs(H.IMAGE_KEYS) do
		local id = H.assetIdFrom(meta[key])
		if id then
			return id
		end
	end
	for k, v in pairs(meta) do
		if type(k) == "string" then
			local lk = k:lower()
			for _, p in ipairs(H.IMAGE_PATTERNS) do
				if lk:find(p, 1, true) then
					local id = H.assetIdFrom(v)
					if id then
						return id
					end
					if type(v) == "table" then
						for _, v2 in pairs(v) do
							local id2 = H.assetIdFrom(v2)
							if id2 then
								return id2
							end
						end
					end
					break
				end
			end
		end
	end
	return nil
end

H.guiIndex, H.guiIndexAt = {}, -100

function H.rebuildGuiIndex()
	H.guiIndex = {}
	H.guiIndexAt = os.clock()
	local ok = pcall(function()
		for _, d in ipairs(PlayerGui:GetDescendants()) do
			if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" then
				local sg = d:FindFirstAncestorOfClass("ScreenGui")
				if not (sg and sg.Name == GUI_NAME) then
					local p = d.Parent
					for _ = 1, 2 do
						if p and p ~= PlayerGui and not p:IsA("ScreenGui") then
							local k = normKey(p.Name)
							if k ~= "" and H.guiIndex[k] == nil then
								H.guiIndex[k] = d.Image
							end
							for _, sib in ipairs(p:GetChildren()) do
								if sib:IsA("TextLabel") and #sib.Text > 1 and #sib.Text < 40 then
									local tk = normKey(sib.Text)
									if tk ~= "" and H.guiIndex[tk] == nil then
										H.guiIndex[tk] = d.Image
									end
								end
							end
							p = p.Parent
						end
					end
				end
			end
		end
	end)
	if not ok then
		H.guiIndex = {}
	end
end

H.iconCache = {}

local function iconFor(dataID, name)
	local ck = tostring(dataID or name)
	local cached = H.iconCache[ck]
	if cached ~= nil then
		return cached or nil
	end

	local result
	local meta = dataID and WeaponsDB[dataID]
	if type(meta) == "table" then
		result = H.metaImageId(meta)
	end

	if not result then
		local keys = {}
		if dataID then
			keys[#keys + 1] = normKey(dataID)
		end
		if name then
			keys[#keys + 1] = normKey(name)
		end
		for pass = 1, 2 do
			for _, k in ipairs(keys) do
				if H.guiIndex[k] then
					result = H.guiIndex[k]
					break
				end
			end
			if result or pass == 2 or os.clock() - H.guiIndexAt < 20 then
				break
			end
			H.rebuildGuiIndex()
		end
	end

	H.iconCache[ck] = result or false
	return result
end

----------------------------------------------------------------------
-- owned items (your inventory) - read-only
-- v14.8 detection: many remotes, strict parser, best answer wins, visible-GUI fallback
----------------------------------------------------------------------

local OWNED = { map = {}, count = 0, at = -100, source = "not loaded", busy = false, tried = {}, guiOnly = false }

H.OWNED_REMOTES = {
	{ "Remotes", "Extras", "GetFullInventory" },
	{ "Remotes", "Inventory", "GetProfileData" },
	{ "Remotes", "Extras", "GetProfileData" },
	{ "Remotes", "Inventory", "GetFullInventory" },
	{ "Remotes", "Extras", "GetInventory" },
}
H.OWNED_NAME_HINTS = { "inventory", "profile", "owned" }

function H.findRemote(path)
	local node = RS
	for _, name in ipairs(path) do
		node = node and node:FindFirstChild(name)
	end
	return node
end

-- remotes to try: the known ones first, then anything that looks like an inventory remote
function H.candidateRemotes()
	local list, seen = {}, {}
	local function add(r, label)
		if r and r:IsA("RemoteFunction") and not seen[r] then
			seen[r] = true
			list[#list + 1] = { remote = r, label = label }
		end
	end
	for _, path in ipairs(H.OWNED_REMOTES) do
		add(H.findRemote(path), table.concat(path, "."))
	end
	pcall(function()
		for _, d in ipairs(RS:GetDescendants()) do
			if d:IsA("RemoteFunction") then
				local ln = d.Name:lower()
				for _, hint in ipairs(H.OWNED_NAME_HINTS) do
					if ln:find(hint, 1, true) then
						add(d, (d:GetFullName():gsub("^ReplicatedStorage%.", "")))
						break
					end
				end
			end
		end
	end)
	return list
end

-- call a RemoteFunction without ever hanging: gives up after `limit` seconds
function H.invokeWithTimeout(remote, limit, ...)
	local args = table.pack(...)
	local done, ok, res = false, false, nil
	task.spawn(function()
		ok, res = pcall(function()
			return remote:InvokeServer(table.unpack(args, 1, args.n))
		end)
		done = true
	end)
	local waited = 0
	while not done and waited < limit do
		task.wait(0.1)
		waited = waited + 0.1
	end
	if done and ok then
		return res
	end
	return nil
end

-- strict parser: an id only counts when it exists in WeaponsDB
function H.isItem(id)
	return type(id) == "string" and WeaponsDB[id] ~= nil
end

function H.parsePayload(root)
	local out, visited = {}, {}

	-- an amount must be a real number >= 1; anything else is skipped (never assumed to be 1)
	local function add(id, qty)
		if type(qty) ~= "number" or qty ~= qty then
			return
		end
		qty = math.floor(qty)
		if qty < 1 then
			return
		end
		out[id] = (out[id] or 0) + qty
	end

	local function walk(node, depth)
		if type(node) ~= "table" or depth > 7 or visited[node] then
			return
		end
		visited[node] = true

		-- shape A: tuple { "DataID", amount, ... }
		if H.isItem(node[1]) and type(node[2]) == "number" then
			add(node[1], node[2])
			return
		end
		-- shape B: record { DataID = "...", Amount = n }
		local rid = node.DataID or node.DataId or node.ItemID or node.ItemId
		if H.isItem(rid) then
			add(rid, node.Amount or node.Count or node.Qty or node.Quantity)
			return
		end

		for k, v in pairs(node) do
			if H.isItem(k) and type(v) == "number" and v > 0 then
				-- shape C: { DataID = amount }
				add(k, v)
			elseif H.isItem(k) and type(v) == "table" then
				-- shape D: { DataID = { Amount = n } }
				add(k, v.Amount or v.Count or v.Qty or v.Quantity)
			elseif type(k) == "number" and H.isItem(v) then
				-- shape E: array of ids (each listed id is one owned item)
				add(v, 1)
			elseif type(v) == "table" then
				walk(v, depth + 1)
			end
		end
	end

	-- prefer the known "owned" containers, but fall back to the whole payload
	local start = root
	if type(root) == "table" then
		if type(root.Weapons) == "table" then
			start = type(root.Weapons.Owned) == "table" and root.Weapons.Owned or root.Weapons
		elseif type(root.Owned) == "table" then
			start = root.Owned
		end
	end
	walk(start, 0)
	if next(out) == nil and start ~= root then
		visited = {}
		walk(root, 0)
	end
	return out
end

-- kept under the old name so older callers keep working
function H.ownedFromPayload(data)
	return H.parsePayload(data)
end

-- true only when the instance and every ancestor is really shown on screen
function H.isShown(inst)
	local node = inst
	while node and node ~= PlayerGui do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		if node:IsA("ScreenGui") and not node.Enabled then
			return false
		end
		node = node.Parent
	end
	if inst:IsA("GuiObject") then
		local s = inst.AbsoluteSize
		if s.X <= 0 or s.Y <= 0 then
			return false
		end
	end
	return true
end

-- GUI fallback: read item names that are visible in the inventory UI (your own PlayerGui only).
-- Only a name that belongs to exactly one game item is accepted. Quantities are NOT read.
function H.detectFromGui()
	local out = {}
	local index = getIdByKey()
	pcall(function()
		for _, d in ipairs(PlayerGui:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text ~= "" and #d.Text < 40 then
				local sg = d:FindFirstAncestorOfClass("ScreenGui")
				if not (sg and sg.Name == GUI_NAME) and H.isShown(d) then
					local id = index[normKey(d.Text)]
					if id then
						out[id] = 1
					end
				end
			end
		end
	end)
	return out
end

-- returns map(id -> qty) or nil, plus report { source, tried = { {label, n} ... }, guiOnly }
-- must be called from a task.spawn (it waits on the remotes)
function H.detectInventory()
	local report = { source = "none", tried = {}, guiOnly = false }
	local best, bestN = nil, 0

	for _, c in ipairs(H.candidateRemotes()) do
		for _, arg in ipairs({ "none", "name" }) do
			local res
			if arg == "none" then
				res = H.invokeWithTimeout(c.remote, 4)
			else
				res = H.invokeWithTimeout(c.remote, 4, MY_NAME)
			end
			if type(res) == "table" then
				local map = H.parsePayload(res)
				local n = countKeys(map)
				report.tried[#report.tried + 1] = { label = c.label .. " (" .. arg .. ")", n = n }
				if n > bestN then
					best, bestN = map, n
					report.source = c.label
				end
			else
				report.tried[#report.tried + 1] = { label = c.label .. " (" .. arg .. ")", n = -1 }
			end
			if bestN > 0 then
				break
			end
		end
		if bestN > 0 then
			break
		end
	end

	if best then
		return best, report
	end

	local guiMap = H.detectFromGui()
	if countKeys(guiMap) > 0 then
		report.source = "inventory GUI (visible names only, quantities not read)"
		report.guiOnly = true
		return guiMap, report
	end
	return nil, report
end

local function refreshOwned(onDone)
	if OWNED.busy then
		return
	end
	OWNED.busy = true
	task.spawn(function()
		local ok, map, report = pcall(H.detectInventory)
		if not ok then
			report = { source = "detection error: " .. tostring(map), tried = {} }
			map = nil
		end

		OWNED.tried = report and report.tried or {}
		if map then
			OWNED.map = map
			OWNED.count = countKeys(map)
			OWNED.source = report.source
			OWNED.guiOnly = report.guiOnly == true
			log(string.format("Inventory read: %d owned item types (%s).", OWNED.count, OWNED.source))
		else
			OWNED.source = (report and report.source ~= "none") and report.source
				or "none of the inventory remotes answered and no inventory GUI was found"
			log("Could not read your inventory - " .. OWNED.source)
		end
		OWNED.at = os.clock()
		OWNED.busy = false
		if onDone then
			pcall(onDone)
		end
	end)
end

----------------------------------------------------------------------
-- values table
----------------------------------------------------------------------

local VALUES = { list = {}, byKey = {}, byKeyAll = {}, exact = {}, byRarity = {}, count = 0, categories = 0, source = "" }

-- closest-match results are cached per (rarity, name)
H.matchCache = {}

local function resetValues()
	VALUES.list = {}
	VALUES.byKey = {}
	VALUES.byKeyAll = {}
	VALUES.exact = {}
	VALUES.byRarity = {}
	VALUES.count = 0
	VALUES.categories = 0
	H.matchCache = {}
end

-- "ANCIENT" -> "Ancient", "SET" -> "Set"
function H.titleCase(str)
	return (tostring(str):lower():gsub("(%a)([%w']*)", function(a, b)
		return a:upper() .. b
	end))
end

-- tag every value entry with its rarity. The rarity is the category header the row sits under in the
-- values file; the game database is only used for rows that have no category (category "MISC").
-- Also indexes entries by rarity (for closest matching) and by name (for same-rarity name lookups).
function H.annotateValues()
	local ids = getIdByKey()
	local byRarity, byKeyAll = {}, {}
	for _, e in ipairs(VALUES.list) do
		local rarity
		local cat = tostring(e.category or "")
		if cat ~= "" and cat ~= "MISC" then
			rarity = H.titleCase(cat)
		else
			local id = (type(e.dataID) == "string" and WeaponsDB[e.dataID] ~= nil) and e.dataID or ids[e.key]
			if id ~= nil then
				local _, r = itemLabel(id)
				rarity = r
			end
			rarity = rarity or "Other"
		end
		e.rarity = rarity
		e.year = H.yearFrom(e.name)

		local bucket = byRarity[rarity]
		if not bucket then
			bucket = {}
			byRarity[rarity] = bucket
		end
		bucket[#bucket + 1] = e

		if e.key ~= "" then
			local list = byKeyAll[e.key]
			if not list then
				list = {}
				byKeyAll[e.key] = list
			end
			list[#list + 1] = e
		end
	end
	VALUES.byRarity = byRarity
	VALUES.byKeyAll = byKeyAll
	H.matchCache = {}
end

-- rarity shown in the VALUES preview: prefer the tagged rarity, fall back to the item id / name
function H.entryRarity(e)
	if e.rarity and e.rarity ~= "Other" then
		return e.rarity
	end
	local id = e.dataID
	if type(id) == "string" and WeaponsDB[id] ~= nil then
		local _, r = itemLabel(id)
		return r
	end
	local gid = getIdByKey()[e.key]
	if gid ~= nil then
		local _, r = itemLabel(gid)
		return r
	end
	return nil
end

function H.addValue(category, name, value, demand, stability, dataID)
	if not name or name == "" or not value then
		return false
	end
	local entry = {
		category = category or "MISC",
		name = name,
		value = value,
		demand = demand or 5,
		stability = stability or "N/A",
		key = normKey(name),
		dataID = dataID,
	}
	VALUES.list[#VALUES.list + 1] = entry
	if entry.key ~= "" and VALUES.byKey[entry.key] == nil then
		VALUES.byKey[entry.key] = entry
	end
	-- also register under the game item id so per-variant lookups succeed
	if type(dataID) == "string" and dataID ~= "" then
		local ik = normKey(dataID)
		if ik ~= "" and VALUES.byKey[ik] == nil then
			VALUES.byKey[ik] = entry
		end
	end
	local lower = name:lower()
	if VALUES.exact[lower] == nil then
		VALUES.exact[lower] = entry
	end
	return true
end

function H.parseTxt(text)
	local category = "MISC"
	local seenCat = {}
	local n = 0

	for raw in text:gmatch("[^\r\n]+") do
		local line = trim((raw:gsub("\t", "  ")))
		if line == "" then
			continue
		end
		if line:find("^MM2 VALUES") or line:find("^Scraped") then
			continue
		end
		if line:find("^%-%-") or line:find("^===") then
			continue
		end

		local cat = line:match("^(%u[%u ]*)%s*%(%d+%)$")
		if cat then
			category = trim(cat)
			seenCat[category] = true
			continue
		end

		if line:match("^Name%s+Value") then
			continue
		end

		local cols = H.splitCols(line)
		if #cols >= 4 then
			local value = tonumber((cols[2]:gsub(",", "")))
			local demand = tonumber(cols[3])
			if value and demand then
				if H.addValue(category, cols[1], value, demand, cols[4], cols[5]) then
					n = n + 1
				end
			end
		end
	end

	VALUES.categories = countKeys(seenCat)
	return n
end

function H.parseCsv(text)
	local category = "MISC"
	local seenCat = {}
	local n = 0

	for raw in text:gmatch("[^\r\n]+") do
		local line = trim(raw)
		if line ~= "" then
			local cols = H.splitCsvLine(line)
			if #cols >= 5 then
				local value = tonumber((cols[3]:gsub(",", "")))
				local demand = tonumber(cols[4])
				if value and demand and cols[2] ~= "name" then
					local cat = cols[1] ~= "" and cols[1]:upper() or category
					seenCat[cat] = true
					if H.addValue(cat, cols[2], value, demand, cols[5], cols[6]) then
						n = n + 1
					end
				end
			end
		end
	end

	VALUES.categories = countKeys(seenCat)
	return n
end

local function parseValues(text)
	resetValues()
	text = text or ""
	local n, kind
	if text:find("category,name,value", 1, true)
		or (text:find('"', 1, true) and text:find(",", 1, true) and not text:find("Name%s+Value")) then
		n, kind = H.parseCsv(text), "csv"
	else
		n, kind = H.parseTxt(text), "txt"
	end
	H.annotateValues()
	return n, kind
end

-- Godly and Chroma weapons share a bucket in the values file, so they count as compatible rarities
function H.rarityCompat(a, b)
	if not a or not b or a == "Other" or b == "Other" then
		return true
	end
	if a == b then
		return true
	end
	local function g(x)
		return x == "Chroma" or x == "Godly"
	end
	return g(a) and g(b)
end

-- true when a value entry's name says the OPPOSITE weapon type of the item ("... Gun" for a knife)
function H.wrongKind(e, kind)
	if not kind then
		return false
	end
	local other = kind == "knife" and "gun" or "knife"
	return e.name:lower():find("%f[%a]" .. other .. "%f[%A]") ~= nil
end

-- exact name lookup that respects rarity, year and weapon type:
--   * an entry whose name carries a DIFFERENT year than the item is never used
--   * an entry whose name says the opposite weapon type is never used
--   * same rarity first, then a compatible rarity; wrong-rarity entries are rejected while SAME RARITY is on
function H.lookupRarity(name, rarity, year, kind)
	local all = VALUES.byKeyAll and VALUES.byKeyAll[normKey(name)]
	if not all or #all == 0 then
		return nil
	end
	local list = {}
	for _, e in ipairs(all) do
		local yearOk = not (year and e.year and e.year ~= year)
		if yearOk and not H.wrongKind(e, kind) then
			list[#list + 1] = e
		end
	end
	if #list == 0 then
		return nil
	end
	if rarity and rarity ~= "Other" then
		local fallback
		for _, e in ipairs(list) do
			if e.rarity == rarity then
				if not year or e.year == year then
					return e
				end
				fallback = fallback or e
			end
		end
		if fallback then
			return fallback
		end
		for _, e in ipairs(list) do
			if H.rarityCompat(e.rarity, rarity) then
				return e
			end
		end
		if SETTINGS.matchSameRarity then
			return nil
		end
	end
	return list[1]
end

-- kept for older callers; now goes through the rarity-aware lookup
function H.lookupKey(name, rarity, year, kind)
	return H.lookupRarity(name, rarity, year, kind)
end

----------------------------------------------------------------------
-- closest-name matching (same rarity only; OFF by default)
----------------------------------------------------------------------

local function levDistance(a, b)
	local la, lb = #a, #b
	if la == 0 then
		return lb
	end
	if lb == 0 then
		return la
	end
	if la > lb then
		a, b = b, a
		la, lb = lb, la
	end
	local prev, cur = {}, {}
	for j = 0, lb do
		prev[j] = j
	end
	for i = 1, la do
		cur[0] = i
		local ca = a:byte(i)
		for j = 1, lb do
			local cost = ca == b:byte(j) and 0 or 1
			local v = prev[j] + 1
			local ins = cur[j - 1] + 1
			if ins < v then
				v = ins
			end
			local sub = prev[j - 1] + cost
			if sub < v then
				v = sub
			end
			cur[j] = v
		end
		prev, cur = cur, prev
	end
	return prev[lb]
end

local function tokenSet(s)
	local set, n = {}, 0
	for w in s:gmatch("[%a%d]+") do
		if not set[w] then
			set[w] = true
			n = n + 1
		end
	end
	return set, n
end

-- 0..1 similarity between two item names (normalised key + word overlap + containment)
local function nameScore(qk, qraw, ck, craw)
	if qk == ck then
		return 1
	end
	local score = 0
	local la, lb = #qk, #ck
	if la > 0 and lb > 0 then
		score = 1 - levDistance(qk, ck) / math.max(la, lb)
		local short, long = qk, ck
		if la > lb then
			short, long = ck, qk
		end
		if #short >= 4 and long:find(short, 1, true) then
			score = math.max(score, 0.72 + 0.25 * (#short / #long))
		end
	end
	local sa, na = tokenSet(qraw)
	local sb, nb = tokenSet(craw)
	if na > 0 and nb > 0 then
		local inter = 0
		for w in pairs(sa) do
			if sb[w] then
				inter = inter + 1
			end
		end
		if inter > 0 then
			score = math.max(score, 0.45 + 0.5 * (inter / (na + nb - inter)))
		end
	end
	return math.clamp(score, 0, 1)
end

-- returns the closest value entry of the same rarity, plus its similarity score
-- hint = "knife" / "gun" (optional) nudges ties toward the right weapon type
function H.closestValue(name, rarity, hint, year)
	if VALUES.count == 0 then
		return nil, 0
	end
	rarity = rarity or "Other"
	local qraw = tostring(name):lower()
	local qk = normKey(name)

	local bucket = VALUES.byRarity and VALUES.byRarity[rarity]
	if not bucket or #bucket == 0 then
		if SETTINGS.matchSameRarity then
			return nil, 0
		end
		bucket = VALUES.list
	end

	local cacheKey = tostring(rarity) .. "\1" .. qk .. "\1" .. tostring(hint) .. "\1" .. tostring(year)
	local cached = H.matchCache[cacheKey]
	if cached ~= nil then
		if cached == false then
			return nil, 0
		end
		return cached.e, cached.score
	end

	local other = hint == "knife" and "gun" or (hint == "gun" and "knife" or nil)
	local best, bestScore = nil, 0
	for _, e in ipairs(bucket) do
		local s = nameScore(qk, qraw, e.key, e.name:lower())
		if hint then
			local ln = e.name:lower()
			if ln:find(hint, 1, true) then
				s = math.min(1, s + 0.06)
			elseif other and ln:find(other, 1, true) then
				s = s - 0.12
			end
		end
		if year and e.year then
			if e.year == year then
				s = math.min(1, s + 0.08)
			else
				s = s - 0.10
			end
		end
		if s > bestScore then
			bestScore, best = s, e
		end
	end

	if not best or bestScore < SETTINGS.matchThreshold then
		H.matchCache[cacheKey] = false
		return nil, 0
	end
	H.matchCache[cacheKey] = { e = best, score = bestScore }
	return best, bestScore
end

-- top-n closest entries as { { e = entry, score = 0..1 }, ... }; used by ctx.closest
function H.fuzzyTop(name, rarity, n, anyRarity)
	local out = {}
	if VALUES.count == 0 then
		return out
	end
	local qraw = tostring(name):lower()
	local qk = normKey(name)
	local bucket = VALUES.list
	if not anyRarity and rarity ~= nil and VALUES.byRarity and VALUES.byRarity[rarity] then
		bucket = VALUES.byRarity[rarity]
	end
	for _, e in ipairs(bucket) do
		out[#out + 1] = { e = e, score = nameScore(qk, qraw, e.key, e.name:lower()) }
	end
	table.sort(out, function(a, b)
		return a.score > b.score
	end)
	while #out > (n or 3) do
		table.remove(out)
	end
	return out
end

-- Exact value lookup. Builds only names that are WRITTEN in the item's own id / game name:
--   name + kind + (event year) / (year), then plain name, then name + (game rarity).
-- Nothing is guessed: a missing kind, year or event simply means those variants are not tried.
local function valueFor(dataID, displayName)
	if VALUES.count == 0 then
		return nil
	end

	local name = displayName or (itemLabel(dataID))
	local _, gameRarity = itemLabel(dataID)
	local sid = tostring(dataID)
	local year = H.yearFrom(sid) or H.yearFrom(name)
	local kind = H.weaponKind(dataID)
	local event = H.idEvent(dataID)

	-- per-variant DataID entry: trusted when the entry carries that DataID, otherwise rarity-gated
	local hit = VALUES.byKey[normKey(sid)]
	if hit then
		local trusted = type(hit.dataID) == "string" and hit.dataID:lower() == sid:lower()
		if trusted or not SETTINGS.matchSameRarity or H.rarityCompat(hit.rarity, gameRarity) then
			return hit, { exact = true }
		end
	end

	local tries, seen = {}, {}
	local function T(s)
		if s and not seen[s] then
			seen[s] = true
			tries[#tries + 1] = s
		end
	end

	local kw = kind == "knife" and "Knife" or (kind == "gun" and "Gun" or nil)
	if not name:find("%(", 1) then
		if kw then
			if event and year then
				T(name .. " " .. kw .. " (" .. event .. " " .. year .. ")")
			end
			if year then
				T(name .. " " .. kw .. " (" .. year .. ")")
			end
			if event and year then
				T(name .. " (" .. event .. " " .. year .. ")")
			end
			if year then
				T(name .. " (" .. year .. ")")
			end
			T(name .. " " .. kw)
		else
			if event and year then
				T(name .. " (" .. event .. " " .. year .. ")")
			end
			if year then
				T(name .. " (" .. year .. ")")
			end
		end
	end
	T(name)
	if gameRarity and gameRarity ~= "Other" then
		T(name .. " (" .. gameRarity .. ")")
	end

	for _, nm in ipairs(tries) do
		hit = H.lookupRarity(nm, gameRarity, year, kind)
		if hit then
			return hit, { exact = true, byYear = nm ~= name and year ~= nil }
		end
	end

	-- names that already carry a tag: "Tree Knife (2015)" -> "2015 Tree Knife", "Foo (Bar)" -> "Bar Foo"
	local base, tag = name:match("^(.-)%s*%((.-)%)$")
	if base and tag and base ~= "" then
		hit = H.lookupRarity(tag .. " " .. base, gameRarity, year, kind)
		if hit then
			return hit, { exact = true }
		end
	end

	local prefix, rest = name:match("^(%S+)%s+(.+)$")
	if prefix and rest then
		hit = H.lookupRarity(rest .. " (" .. prefix .. ")", gameRarity, year, kind)
		if hit then
			return hit, { exact = true }
		end
	end

	-- OPTIONAL (off by default): closest name inside the SAME rarity
	if SETTINGS.matchFuzzy then
		local e, score = H.closestValue(name, gameRarity, kind, year)
		if not e and gameRarity == "Chroma" then
			e, score = H.closestValue(name, "Godly", kind, year)
		end
		if e then
			return e, { exact = false, score = score, matched = e.name }
		end
	end
	return nil
end

H.valueOf = valueFor

