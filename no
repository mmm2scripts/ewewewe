function H.addCommas(digits)
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

local function fmt(n)
	if type(n) ~= "number" or n ~= n then
		return "?"
	end
	if n == math.huge then
		return "∞"
	end
	local sign = ""
	if n < 0 then
		sign = "-"
		n = -n
	end
	local whole = math.floor(n)
	local frac = n - whole
	if frac >= 0.995 then
		whole = whole + 1
		frac = 0
	end
	local out = H.addCommas(tostring(whole))
	if frac >= 0.005 then
		local f = string.format("%.2f", frac):sub(2)
		f = f:gsub("0$", "")
		out = out .. f
	end
	return sign .. out
end

local function fmtDemand(d)
	if type(d) ~= "number" then
		return "?"
	end
	if d == math.floor(d) then
		return tostring(math.floor(d))
	end
	return string.format("%.2f", d)
end

local function normKey(s)
	return (tostring(s):lower():gsub("[^%a%d]", ""))
end

-- release year from a game item id ("Ginger_G_2018" -> 2018) or a display name ("Tree Knife (2015)")
function H.yearFrom(s)
	if type(s) ~= "string" then
		return nil
	end
	for y in s:gmatch("(%d%d%d%d)") do
		local n = tonumber(y)
		if n and n >= 2015 and n <= 2030 then
			return n
		end
	end
	return nil
end

-- knife / gun, read ONLY from the explicit text of a game id:  Blossom_K_2026, Clown_G, Gingermint_KChroma,
-- AduriteGun, CamoKnife.  Returns nil when the id does not say.
function H.idKind(id)
	if type(id) ~= "string" then
		return nil
	end
	local k = id:match("_([KG])_%d%d%d%d$") or id:match("_([KG])$") or id:match("_([KG])Chroma$")
	if k then
		return k == "K" and "knife" or "gun"
	end
	if id:match("Knife$") then
		return "knife"
	end
	if id:match("Gun$") then
		return "gun"
	end
	return nil
end

