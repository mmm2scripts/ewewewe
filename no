function H.splitCols(line)
	-- split on 2+ spaces; the name may contain single spaces, the rest are single tokens
	local cols = {}
	local name, rest = line:match("^(.-)%s%s+(.+)$")
	if not name then
		cols[#cols + 1] = trim(line)
		return cols
	end
	cols[#cols + 1] = trim(name)
	for token in rest:gmatch("%S+") do
		cols[#cols + 1] = token
	end
	return cols
end

function H.splitCsvLine(line)
	local out, field = {}, {}
	local inQuotes = false
	local i = 1
	while i <= #line do
		local c = line:sub(i, i)
		if inQuotes then
			if c == '"' then
				if line:sub(i + 1, i + 1) == '"' then
					field[#field + 1] = '"'
					i = i + 1
				else
					inQuotes = false
				end
			else
				field[#field + 1] = c
			end
		elseif c == '"' then
			inQuotes = true
		elseif c == "," then
			out[#out + 1] = table.concat(field)
			field = {}
		else
			field[#field + 1] = c
		end
		i = i + 1
	end
	out[#out + 1] = table.concat(field)
	return out
end

