----------------------------------------------------------------------
-- pentagram sigil
----------------------------------------------------------------------

function H.makeSigil(parent, size, props, color, transp, thick)
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Active = false,
	}, parent)
	for k, v in pairs(props) do
		holder[k] = v
	end

	local function ring(scaleSize)
		local r = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(scaleSize, scaleSize),
			BackgroundTransparency = 1,
		}, holder)
		corner(r, size)
		stroke(r, color, thick, transp)
	end
	ring(1)
	ring(0.86)

	local c = size / 2
	local R = size * 0.43
	local pts = {}
	for i = 0, 4 do
		local a = math.rad(-90 + 72 * i)
		pts[i] = Vector2.new(c + R * math.cos(a), c + R * math.sin(a))
	end
	for i = 0, 4 do
		local a, b = pts[i], pts[(i + 2) % 5]
		local mid = (a + b) / 2
		local d = b - a
		new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(mid.X, mid.Y),
			Size = UDim2.fromOffset(d.Magnitude, thick),
			Rotation = math.deg(math.atan2(d.Y, d.X)),
			BackgroundColor3 = color,
			BackgroundTransparency = transp,
			BorderSizePixel = 0,
