function H.buildRows(list)
	local rows = {}
	for _, e in ipairs(list) do
		local entry, match = valueFor(e.dataID, e.name)
		local unit = entry and entry.value or 0
		local rarity = e.rarity
		if entry and entry.rarity and match and match.exact == true then
			rarity = entry.rarity
		end
		rows[#rows + 1] = {
			dataID = e.dataID,
			name = e.name,
			year = e.year,
			event = e.event,
			rarity = rarity,
			qty = e.qty,
			unit = unit,
			total = unit * e.qty,
			demand = entry and entry.demand or 5,
			stability = entry and entry.stability or "N/A",
			valueEntry = entry,
			known = entry ~= nil,
			approx = match ~= nil and match.exact == false,
			matchPct = match and match.score and math.floor(match.score * 100 + 0.5) or nil,
			matchedName = match and match.matched or nil,
		}
	end
	return rows
end

function H.totals(rows)
	local raw, weighted, unpriced = 0, 0, 0
	for _, row in ipairs(rows) do
		if row.known then
			raw = raw + row.total
			weighted = weighted + row.total * demandWeight(row.demand)
		else
			unpriced = unpriced + row.qty
		end
	end
	return raw, weighted, unpriced
end

function H.setBar(fill, value, maxValue)
	local share = 0
	if maxValue > 0 then
		share = math.clamp(value / maxValue, 0, 1)
	end
	tween(fill, { Size = UDim2.new(math.max(share, 0.01), 0, 1, 0) }, 0.25)
end

function H.sideSig(rows)
	local parts = {}
	for _, r in ipairs(rows) do
		parts[#parts + 1] = r.dataID .. "x" .. r.qty .. (r.known and "k" or "u") .. (r.approx and "~" or "")
	end
	return table.concat(parts, "|")
end

