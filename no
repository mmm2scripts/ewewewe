function H.runStyleLua(code)
	code = tostring(code or "")
	if code:gsub("%s", "") == "" then
		H.luaMsg("the box is empty - paste a script or press EXAMPLE", C.amber)
		return false
	end
	local loader = loadstring or load
	if type(loader) ~= "function" then
		H.luaMsg("this executor has no loadstring, so custom scripts can't run", C.red)
		return false
	end
	local fn, err = loader(code, "=tradeval_style")
	if not fn then
		H.luaMsg("syntax error: " .. tostring(err), C.red)
		return false
	end
	local env = setmetatable({
		ctx = H.ctx,
		print = function(...)
			local bits = {}
			for i = 1, select("#", ...) do
				bits[#bits + 1] = tostring((select(i, ...)))
			end
			log("[style] " .. table.concat(bits, " "))
		end,
	}, {
		__index = (type(getgenv) == "function" and getgenv()) or _G,
	})
	if type(setfenv) == "function" then
		pcall(setfenv, fn, env)
	end
	local ok, res = pcall(fn, H.ctx)
	if not ok then
		H.luaMsg("runtime error: " .. tostring(res), C.red)
		log("Custom style error: " .. tostring(res))
		return false
	end
	H.luaMsg("style script ran OK  (" .. #code .. " chars)", C.green)
	log("Custom style script ran.")
	return true
end

