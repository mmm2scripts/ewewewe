-- a touch is only followed by the finger that started it; the mouse by any mouse movement
function H.isMine(input, rec)
	if rec.touch then
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return false
		end
		if input == rec.input then
			return true
		end
		-- some executors hand out a fresh object per touch event: follow the finger by position instead
		return (Vector2.new(input.Position.X, input.Position.Y) - rec.last).Magnitude < 250
	end
	return input.UserInputType == Enum.UserInputType.MouseMovement
end

function H.endsMine(input, rec)
	local t = input.UserInputType
	if rec.touch then
		if t ~= Enum.UserInputType.Touch then
			return false
		end
		if input == rec.input then
			return true
		end
		return (Vector2.new(input.Position.X, input.Position.Y) - rec.last).Magnitude < 250
	end
	return t == Enum.UserInputType.MouseButton1
end

track(UserInput.InputChanged:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if resizing then
		if not H.isMine(input, resizing) then
			return
		end
		resizing.last = Vector2.new(input.Position.X, input.Position.Y)
		local vp = viewport()
		local minW, minH = minSize()
		local dx = input.Position.X - resizing.mouse.X
		local dy = input.Position.Y - resizing.mouse.Y
		local r = resizing

		local newW, newH = r.size.X, r.size.Y
		if r.sx ~= 0 then
			local maxW = r.sx == -1 and (r.size.X + r.pos.X) or (vp.X - r.pos.X)
			maxW = math.max(maxW, r.size.X, minW)
			newW = math.clamp(r.size.X + r.sx * dx, minW, maxW)
		end
		if r.sy ~= 0 then
			local maxH = r.sy == -1 and (r.size.Y + r.pos.Y - H.TOP_LIM) or (vp.Y - r.pos.Y)
			maxH = math.max(maxH, r.size.Y, minH)
			newH = math.clamp(r.size.Y + r.sy * dy, minH, maxH)
		end
		local posX = r.sx == -1 and (r.pos.X + (r.size.X - newW)) or r.pos.X
		local posY = r.sy == -1 and (r.pos.Y + (r.size.Y - newH)) or r.pos.Y
		win.Size = UDim2.fromOffset(newW, newH)
		win.Position = UDim2.fromOffset(posX, posY)
	elseif dragging then
		if not H.isMine(input, dragging) then
			return
		end
		dragging.last = Vector2.new(input.Position.X, input.Position.Y)
		local vp = viewport()
		local dx = input.Position.X - dragging.mouse.X
		local dy = input.Position.Y - dragging.mouse.Y
		local w = win.Size.X.Offset
		win.Position = UDim2.fromOffset(
			math.clamp(dragging.pos.X + dx, -(w - 120), vp.X - 120),
			math.clamp(dragging.pos.Y + dy, H.TOP_LIM, math.max(H.TOP_LIM, vp.Y - 50))
		)
	end
end))

track(UserInput.InputEnded:Connect(function(input)
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
		return
	end
	if resizing and H.endsMine(input, resizing) then
		resizing.handle.BackgroundTransparency = 1
		resizing = nil
		SETTINGS.winW = win.Size.X.Offset
		SETTINGS.winH = win.Size.Y.Offset
		saveSettings()
		clampWindow()
	end
	if dragging and H.endsMine(input, dragging) then
		dragging = nil
		clampWindow()
	end
end))

-- touch screens have no 9 key: a small round button shows / hides the window (drag it to move it)
if H.IS_TOUCH then
	local tog = new("TextButton", {
		Name = "ToggleButton",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.1,
		AutoButtonColor = false,
		Text = ".tv",
		Font = Enum.Font.GothamBlack,
		TextSize = 16,
		TextColor3 = C.accent,
		ZIndex = 100,
		Active = true,
	}, gui)
	corner(tog, 22)
	stroke(tog, C.accent, 2, 0.1)

	-- plain top-left anchoring so the maths is simple and the button follows the finger exactly
	tog.AnchorPoint = Vector2.new(0, 0)
	do
		local vp0 = viewport()
		tog.Position = UDim2.fromOffset(math.floor(vp0.X / 2 - 22), 6)
	end

	local tdrag
	tog.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			tdrag = {
				input = input,
				touch = (t == Enum.UserInputType.Touch),
				last = Vector2.new(input.Position.X, input.Position.Y),
				startP = Vector2.new(input.Position.X, input.Position.Y),
				startPos = tog.AbsolutePosition,
				total = 0,
				moved = false,
			}
		end
	end)
	track(UserInput.InputChanged:Connect(function(input)
		if not tdrag or not H.isMine(input, tdrag) then
			return
		end
		local p = Vector2.new(input.Position.X, input.Position.Y)
		tdrag.last = p
		local total = p - tdrag.startP
		if total.Magnitude > 10 then
			tdrag.moved = true
		end
		if tdrag.moved then
			-- absolute from where the finger started, so every touch event counts (no stale-position lag)
			local vp = viewport()
			tog.Position = UDim2.fromOffset(
				math.clamp(tdrag.startPos.X + total.X, 0, math.max(0, vp.X - 44)),
				math.clamp(tdrag.startPos.Y + total.Y, 0, math.max(0, vp.Y - 44))
			)
		end
	end))
	track(UserInput.InputEnded:Connect(function(input)
		if tdrag and H.endsMine(input, tdrag) then
			local wasMoved = tdrag.moved
			tdrag = nil
			if not wasMoved then
				win.Visible = not win.Visible
			end
		end
	end))
end

