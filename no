local WHITE = Color3.new(1, 1, 1)
H.shadeFns = {}
H.crackRecs = {}

function H.regShade(kind, fn)
	H.shadeFns[kind] = H.shadeFns[kind] or {}
	table.insert(H.shadeFns[kind], fn)
	fn()
end

function H.applyShade(kind)
	for _, fn in ipairs(H.shadeFns[kind] or {}) do
		pcall(fn)
	end
end

function H.shadeEnd(s)
	return WHITE:Lerp(Color3.fromRGB(110, 70, 80), math.clamp(s, 0, 1))
end

-- vertical white -> darker gradient used on panels and buttons
function H.shadeGrad(kind, grad, key)
	H.regShade(kind, function()
		if grad.Parent then
			grad.Color = ColorSequence.new(WHITE, H.shadeEnd(SETTINGS[key]))
		end
	end)
end

-- glowing hairline: centre transparency fades toward 1 as the glow setting drops
function H.glowGrad(grad, center)
	H.regShade("glow", function()
		if grad.Parent then
			local c = 1 - (1 - center) * math.clamp(SETTINGS.shadeGlow, 0, 1)
			grad.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, c),
				NumberSequenceKeypoint.new(1, 1),
			})
		end
	end)
end

function H.addCrack(f)
	local base = f.BackgroundTransparency
	H.crackRecs[#H.crackRecs + 1] = { f = f, base = base }
	f.BackgroundTransparency = 1 - (1 - base) * math.clamp(SETTINGS.shadeCracks, 0, 1)
end

H.regShade("cracks", function()
	local k = math.clamp(SETTINGS.shadeCracks, 0, 1)
	for _, rec in ipairs(H.crackRecs) do
		if rec.f.Parent then
			rec.f.BackgroundTransparency = 1 - (1 - rec.base) * k
		end
	end
end)

