local RANK={Common=1,Uncommon=2,Rare=3,Legendary=4,Vintage=5,Godly=6,Ancient=7,Unique=8,Chroma=9}
local function itemLabel(id)
	local m=DB[id]
	if type(m)~="table" then return tostring(id),"Other" end
	local n=m.ItemName or m.Name or tostring(id)
	if m.Chroma==true and not n:lower():find("^chroma") then n="Chroma "..n end
	return n,m.Rarity or "Other"
end
-- name -> game id only when exactly one game item carries that name
local idByKey
local function getIdByKey()
	if idByKey then return idByKey end
	idByKey={}; local amb={}
	for id,m in pairs(DB) do
		if type(m)=="table" then
			local k=nk((itemLabel(id)))
			if idByKey[k]==nil and not amb[k] then idByKey[k]=id
			elseif idByKey[k]~=id then amb[k]=true; idByKey[k]=nil end
		end
	end
	return idByKey
end
local function idEvent(id)
	local ev=eventFromText(tostring(id)); if ev then return ev end
	local m=DB[id]
	if type(m)=="table" then for _,k in ipairs({"Event","Season","Holiday"}) do ev=eventFromText(m[k]); if ev then return ev end end end
end
local function weaponKind(id)
	local k=idKind(tostring(id)); if k then return k end
	local m=id and DB[id]; if type(m)~="table" then return end
	local t=tostring(m.ItemType or m.Type or m.WeaponType or ""):lower()
	if t:find("knife",1,true) then return "knife" end
	if t:find("gun",1,true) then return "gun" end
end
local function knownId(id)
	if type(id)~="string" then return false end
	if next(DB)==nil then return id~="" end
	return DB[id]~=nil
end

---------------------------------------------------------------- values table
local VAL={list={},byKey={},byAll={},byRar={},count=0,cats=0}
local mcache={}
local function resetVals() VAL.list,VAL.byKey,VAL.byAll,VAL.byRar,VAL.count,VAL.cats,mcache={},{},{},{},0,0,{} end
local function title(s) return (tostring(s):lower():gsub("(%a)([%w']*)",function(a,b) return a:upper()..b end)) end
local function addValue(cat,name,value,demand,stab,dataID)
	if not name or name=="" or not value then return false end
	local e={category=cat or "MISC",name=name,value=value,demand=demand or 5,stability=stab or "N/A",key=nk(name),dataID=dataID}
	VAL.list[#VAL.list+1]=e
	if e.key~="" and VAL.byKey[e.key]==nil then VAL.byKey[e.key]=e end
	if type(dataID)=="string" and dataID~="" then local ik=nk(dataID) if ik~="" and VAL.byKey[ik]==nil then VAL.byKey[ik]=e end end
	return true
end
-- tag every entry with its rarity: the category header in the values file, else the game database
local function annotate()
	local ids=getIdByKey(); local byR,byA={},{}
	for _,e in ipairs(VAL.list) do
		local r; local cat=tostring(e.category or "")
		if cat~="" and cat~="MISC" then r=title(cat)
		else
			local id=(type(e.dataID)=="string" and DB[e.dataID]~=nil) and e.dataID or ids[e.key]
			if id then r=select(2,itemLabel(id)) end
			r=r or "Other"
		end
		e.rarity,e.year=r,yearFrom(e.name)
		byR[r]=byR[r] or {}; table.insert(byR[r],e)
		if e.key~="" then byA[e.key]=byA[e.key] or {}; table.insert(byA[e.key],e) end
	end
	VAL.byRar,VAL.byAll,mcache=byR,byA,{}
end
local function splitCols(line)   -- name may hold single spaces, columns are split on 2+ spaces
	local name,rest=line:match("^(.-)%s%s+(.+)$")
	if not name then return {trim(line)} end
	local cols={trim(name)}
	for t in rest:gmatch("%S+") do cols[#cols+1]=t end
	return cols
end
local function splitCsv(line)
	local out,f,q,i={},{},false,1
	while i<=#line do
		local c=line:sub(i,i)
		if q then
			if c=='"' then if line:sub(i+1,i+1)=='"' then f[#f+1]='"'; i=i+1 else q=false end else f[#f+1]=c end
		elseif c=='"' then q=true
		elseif c=="," then out[#out+1]=table.concat(f); f={}
		else f[#f+1]=c end
		i=i+1
	end
	out[#out+1]=table.concat(f)
	return out
end
local function parseTxt(text)
	local cat,seen,n="MISC",{},0
	for raw in text:gmatch("[^\r\n]+") do
		local line=trim((raw:gsub("\t","  ")))
		if line~="" and not line:find("^MM2 VALUES") and not line:find("^Scraped") and not line:find("^%-%-") and not line:find("^===") then
			local c=line:match("^(%u[%u ]*)%s*%(%d+%)$")
			if c then cat=trim(c); seen[cat]=true
			elseif not line:match("^Name%s+Value") then
				local cols=splitCols(line)
				if #cols>=4 then
					local v,d=tonumber((cols[2]:gsub(",",""))),tonumber(cols[3])
					if v and d and addValue(cat,cols[1],v,d,cols[4],cols[5]) then n=n+1 end
				end
			end
		end
	end
	VAL.cats=countKeys(seen); return n
end
local function parseCsv(text)
	local seen,n={},0
	for raw in text:gmatch("[^\r\n]+") do
		local line=trim(raw)
		if line~="" then
			local c=splitCsv(line)
			if #c>=5 then
				local v,d=tonumber((c[3]:gsub(",",""))),tonumber(c[4])
				if v and d and c[2]~="name" then
					local ct=c[1]~="" and c[1]:upper() or "MISC"
					seen[ct]=true
					if addValue(ct,c[2],v,d,c[5],c[6]) then n=n+1 end
				end
			end
		end
	end
	VAL.cats=countKeys(seen); return n
end
local function parseValues(text)
	resetVals(); text=text or ""
	local csv=text:find("category,name,value",1,true) or (text:find('"',1,true) and text:find(",",1,true) and not text:find("Name%s+Value"))
	local n=csv and parseCsv(text) or parseTxt(text)
	annotate(); VAL.count=n
	return n,csv and "csv" or "txt"
end

---------------------------------------------------------------- value lookup (exact names first, optional closest match)
local function rarityCompat(a,b)   -- Godly and Chroma share a bucket in the values file
	if not a or not b or a=="Other" or b=="Other" or a==b then return true end
	local function g(x) return x=="Chroma" or x=="Godly" end
	return g(a) and g(b)
end
local function wrongKind(e,kind)
	if not kind then return false end
	return e.name:lower():find("%f[%a]"..(kind=="knife" and "gun" or "knife").."%f[%A]")~=nil
end
local function lookupRarity(name,rarity,year,kind)
	local all=VAL.byAll[nk(name)]; if not all then return nil end
	local list={}
	for _,e in ipairs(all) do
		if not (year and e.year and e.year~=year) and not wrongKind(e,kind) then list[#list+1]=e end
	end
	if #list==0 then return nil end
	if rarity and rarity~="Other" then
		local fb
		for _,e in ipairs(list) do
			if e.rarity==rarity then
				if not year or e.year==year then return e end
				fb=fb or e
			end
		end
		if fb then return fb end
		for _,e in ipairs(list) do if rarityCompat(e.rarity,rarity) then return e end end
		if S.matchSameRarity then return nil end
	end
	return list[1]
end
local function lev(a,b)
	local la,lb=#a,#b
	if la==0 then return lb end
	if lb==0 then return la end
	local prev,cur={},{}
	for j=0,lb do prev[j]=j end
	for i=1,la do
		cur[0]=i; local ca=a:byte(i)
		for j=1,lb do cur[j]=math.min(prev[j]+1,cur[j-1]+1,prev[j-1]+(ca==b:byte(j) and 0 or 1)) end
		prev,cur=cur,prev
	end
	return prev[lb]
end
local function toks(s) local t,n={},0 for w in s:gmatch("[%a%d]+") do if not t[w] then t[w]=true; n=n+1 end end return t,n end
local function nameScore(qk,qraw,ck,craw)
	if qk==ck then return 1 end
	local sc,la,lb=0,#qk,#ck
	if la>0 and lb>0 then
		sc=1-lev(qk,ck)/math.max(la,lb)
		local sh,lg=qk,ck; if la>lb then sh,lg=ck,qk end
		if #sh>=4 and lg:find(sh,1,true) then sc=math.max(sc,.72+.25*(#sh/#lg)) end
	end
	local sa,na=toks(qraw); local sb,nb=toks(craw)
	if na>0 and nb>0 then
		local i=0
		for w in pairs(sa) do if sb[w] then i=i+1 end end
		if i>0 then sc=math.max(sc,.45+.5*(i/(na+nb-i))) end
	end
	return math.clamp(sc,0,1)
end
local function closest(name,rarity,hint,year)
	if VAL.count==0 then return nil,0 end
	rarity=rarity or "Other"
	local qraw,qk=tostring(name):lower(),nk(name)
	local bucket=VAL.byRar[rarity]
	if not bucket or #bucket==0 then
		if S.matchSameRarity then return nil,0 end
		bucket=VAL.list
	end
	local ck=table.concat({rarity,qk,tostring(hint),tostring(year)},"\1")
	local c=mcache[ck]
	if c~=nil then if c==false then return nil,0 end return c.e,c.score end
	local other=hint=="knife" and "gun" or (hint=="gun" and "knife" or nil)
	local best,bs=nil,0
	for _,e in ipairs(bucket) do
		local ln=e.name:lower(); local s=nameScore(qk,qraw,e.key,ln)
		if hint then if ln:find(hint,1,true) then s=math.min(1,s+.06) elseif other and ln:find(other,1,true) then s=s-.12 end end
		if year and e.year then s=(e.year==year) and math.min(1,s+.08) or (s-.10) end
		if s>bs then bs,best=s,e end
	end
	if not best or bs<S.matchThreshold then mcache[ck]=false; return nil,0 end
	mcache[ck]={e=best,score=bs}
	return best,bs
end
-- returns entry, {exact=bool,score,matched}. Only names WRITTEN in the item's id / game name are tried.
local function valueFor(dataID,disp)
	if VAL.count==0 then return nil end
	local name=disp or (itemLabel(dataID))
	local _,gr=itemLabel(dataID)
	local sid=tostring(dataID)
	local year,kind,event=yearFrom(sid) or yearFrom(name),weaponKind(dataID),idEvent(dataID)
	local hit=VAL.byKey[nk(sid)]
	if hit then
		local trusted=type(hit.dataID)=="string" and hit.dataID:lower()==sid:lower()
		if trusted or not S.matchSameRarity or rarityCompat(hit.rarity,gr) then return hit,{exact=true} end
	end
	local tries,seen={},{}
	local function T(s) if s and not seen[s] then seen[s]=true; tries[#tries+1]=s end end
	local kw=kind=="knife" and "Knife" or (kind=="gun" and "Gun" or nil)
	if not name:find("%(",1) then
		if kw and event and year then T(name.." "..kw.." ("..event.." "..year..")") end
		if kw and year then T(name.." "..kw.." ("..year..")") end
		if event and year then T(name.." ("..event.." "..year..")") end
		if year then T(name.." ("..year..")") end
		if kw then T(name.." "..kw) end
	end
	T(name)
	if gr and gr~="Other" then T(name.." ("..gr..")") end
	for _,nm in ipairs(tries) do
		hit=lookupRarity(nm,gr,year,kind)
		if hit then return hit,{exact=true} end
	end
	local base,tag=name:match("^(.-)%s*%((.-)%)$")   -- "Tree Knife (2015)" -> "2015 Tree Knife"
	if base and tag and base~="" then hit=lookupRarity(tag.." "..base,gr,year,kind); if hit then return hit,{exact=true} end end
	local pre,rest=name:match("^(%S+)%s+(.+)$")
	if pre and rest then hit=lookupRarity(rest.." ("..pre..")",gr,year,kind); if hit then return hit,{exact=true} end end
	if S.matchFuzzy then
		local e,sc=closest(name,gr,kind,year)
		if not e and gr=="Chroma" then e,sc=closest(name,"Godly",kind,year) end
		if e then return e,{exact=false,score=sc,matched=e.name} end
	end
end

---------------------------------------------------------------- discord webhook (one embed per hop / accepted trade; never retries in a loop)
local HOOKS={"https://discord.com/api/webhooks/","https://discordapp.com/api/webhooks/","https://ptb.discord.com/api/webhooks/","https://canary.discord.com/api/webhooks/"}
local function hookValid(u) u=trim(u) for _,p in ipairs(HOOKS) do if u:sub(1,#p)==p and #u>#p+10 then return true end end return false end
local hookBusy,hookLast=false,-1e9
local function sendHook(ttl,detail,color,noPing)   -- pings @everyone unless noPing
	if not S.hookOn then return false,"webhook off" end
	local url=trim(S.hookUrl)
	if not hookValid(url) then return false,"no webhook url" end
	if hookBusy then return false,"a message is already sending" end
	if os.clock()-hookLast<3 then return false,"cooling down" end
	local req=(syn and syn.request) or (http and http.request) or http_request or request
	if type(req)~="function" then return false,"executor has no request()" end
	hookBusy,hookLast=true,os.clock()
	task.spawn(function()
		local ok,body=pcall(function()
			return HS:JSONEncode({username="tradeval",content=noPing and "" or "@everyone",allowed_mentions={parse=noPing and {} or {"everyone"}},
				embeds={{title=tostring(ttl),description=tostring(detail),color=color or 15158332,footer={text=MY_NAME.."  ·  "..VER},timestamp=DateTime.now():ToIsoDate()}}})
		end)
		if ok then pcall(req,{Url=url,Method="POST",Headers={["Content-Type"]="application/json"},Body=body}) end
		task.wait(1); hookBusy=false
	end)
	return true,"queued"
end
local function itemLines(list)   -- "• 2x **Name** (Rarity) - value" + total
	local lines,total={},0
	for i,it in ipairs(list or {}) do
		if i>25 then lines[#lines+1]=string.format("...and %d more",#list-25) break end
		local okv,hit=pcall(valueFor,it.dataID,it.name)
		local v=okv and type(hit)=="table" and type(hit.value)=="number" and hit.value or nil
		if v then total=total+v*it.qty end
		lines[#lines+1]=string.format("• %dx **%s** (%s)%s",it.qty,it.name,tostring(it.rarity),v and (" - "..fmt(v)) or "")
	end
	if #lines==0 then return "(items could not be read)" end
	if total>0 then lines[#lines+1]="Total value: **"..fmt(total).."**" end
	return table.concat(lines,"\n")
end
-- AUTO LOAD: re-run this script in the next server (a teleport kills every script)
local function queueReload()
	if not S.autoLoad or type(queue_on_teleport)~="function" then return false end
	local c=trim(S.loadCmd)
