---------------------------------------------------------------- helpers
local function trim(s) return (tostring(s):match("^%s*(.-)%s*$")) end
local function nk(s) return (tostring(s):lower():gsub("[^%a%d]","")) end
local function countKeys(t) local n=0 for _ in pairs(t) do n=n+1 end return n end
local function fileExists(n) if type(isfile)~="function" then return false end local ok,r=pcall(isfile,n) return ok and r==true end
local function demandWeight(d) return math.clamp(1+((d or 5)-5)*.04,.7,1.4) end
local function fmtDemand(d) if type(d)~="number" then return "?" end return d==math.floor(d) and tostring(math.floor(d)) or string.format("%.2f",d) end
local function fmt(n)
	if type(n)~="number" or n~=n then return "?" end
	if n==math.huge then return "∞" end
	local sg=n<0 and "-" or ""; n=math.abs(n)
	local w=math.floor(n); local f=n-w
	if f>=.995 then w=w+1; f=0 end
	local o=tostring(w):reverse():gsub("(%d%d%d)","%1,"):reverse():gsub("^,","")
	if f>=.005 then o=o..string.format("%.2f",f):sub(2):gsub("0$","") end
	return sg..o
end
local function stabPenalty(s) local l=tostring(s):lower() if l:find("underpaid") then return .03 end if l:find("stable") then return 0 end return .06 end
local function clip(t) local f=setclipboard or toclipboard or writeclipboard if type(f)=="function" then return (pcall(f,t)) end return false end

-- release year from an id ("Ginger_G_2018") or name ("Tree Knife (2015)")
local function yearFrom(s)
	if type(s)~="string" then return end
	for y in s:gmatch("(%d%d%d%d)") do local n=tonumber(y) if n and n>=2015 and n<=2030 then return n end end
end
-- knife / gun ONLY from explicit id text: X_K_2026, X_G, X_KChroma, XKnife, XGun
local function idKind(id)
	if type(id)~="string" then return end
	local k=id:match("_([KG])_%d%d%d%d$") or id:match("_([KG])$") or id:match("_([KG])Chroma$")
	if k then return k=="K" and "knife" or "gun" end
	if id:match("Knife$") then return "knife" end
	if id:match("Gun$") then return "gun" end
end
local EVENTS={{"christmas","Christmas"},{"xmas","Christmas"},{"halloween","Halloween"},{"summer","Summer"},{"easter","Easter"},{"valentine","Valentine's"},{"thanksgiving","Thanksgiving"}}
local function eventFromText(s)
	if type(s)~="string" or s=="" then return end
	local l=s:lower()
	for _,w in ipairs(EVENTS) do if l:find(w[1],1,true) then return w[2] end end
end

