function H.initials(name)
	local a, b = name:match("^(%a+)%s+(%a+)")
	if a and b then
		return (a:sub(1, 1) .. b:sub(1, 1)):upper()
	end
	return name:sub(1, 2):upper()
end

local function iconTile(parent, x, y, size, name, rarity, dataID)
	local tile = new("Frame", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Color3.fromRGB(30, 14, 18),
		BorderSizePixel = 0,
	}, parent)
	corner(tile, math.floor(size * 0.22))

	local isChroma = name:lower():find("^chroma") ~= nil or rarity == "Chroma"
	local baseColor = isChroma and RARITY_COLOR.Chroma or (RARITY_COLOR[rarity] or C.line)

	new("UIGradient", {
		Color = isChroma and CHROMA_SEQ or ColorSequence.new({
			ColorSequenceKeypoint.new(0, baseColor),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(22, 10, 13)),
		}),
		Rotation = 135,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 0.85),
		}),
	}, tile)
	stroke(tile, baseColor, 1)

	local fallback = lbl({
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBlack,
		TextSize = math.floor(size * 0.36),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextTransparency = 0.15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = H.initials(name),
	}, tile)

	local icon = iconFor(dataID, name)
	if icon then
		local img = new("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 2,
		}, tile)
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 3),
			PaddingRight = UDim.new(0, 3),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 3),
		}, img)

		local candidates = {}
		if type(icon) == "number" then
			candidates[1] = string.format("rbxthumb://type=Asset&id=%d&w=150&h=150", icon)
			candidates[2] = "rbxassetid://" .. tostring(icon)
		else
			candidates[1] = tostring(icon)
		end

		task.spawn(function()
			for _, url in ipairs(candidates) do
				if not img.Parent then
					return
				end
				img.Image = url
				local waited = 0
				while img.Parent and not img.IsLoaded and waited < 3 do
					task.wait(0.15)
					waited = waited + 0.15
				end
				if img.Parent and img.IsLoaded then
					fallback.Visible = false
					return
				end
			end
		end)
	end

	return tile
end

