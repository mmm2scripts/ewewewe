renderTrade = function(info)
	local sides = findSides(info)
	if not sides then
		if state.tradeOpen then
			log("Trade closed.")
		end
		clearTrade("WAITING FOR A TRADE")
		return
	end

	if not state.tradeOpen then
		log("Trade detected: " .. tostring(sides.myName) .. " <-> " .. tostring(sides.theirName))
	end
	state.tradeOpen = true
	state.info = info
	state.myAccepted = sides.myAccepted
	state.theirAccepted = sides.theirAccepted
	state.locked = sides.locked
	H.setHeaderStatus(true, "trading with " .. tostring(sides.theirName))

	local giveList = decodeOffer(sides.mine)
	local takeList = decodeOffer(sides.theirs)
	local giveRows = H.buildRows(giveList)
	local takeRows = H.buildRows(takeList)
	T.lastGive, T.lastTake = giveRows, takeRows

	local sig = H.sideSig(giveRows) .. "#" .. H.sideSig(takeRows)
		.. "#" .. tostring(sides.myAccepted) .. tostring(sides.theirAccepted)
	if sig ~= state.sig then
		state.sig = sig
		fillSide(T.give, giveRows, C.blue)
		fillSide(T.take, takeRows, C.green)
	end

	local giveRaw, giveW, giveUnpriced = H.totals(giveRows)
	local takeRaw, takeW, takeUnpriced = H.totals(takeRows)

	state.evalGiveW, state.evalTakeW = giveW, takeW
	local keys = {}
	for _, r in ipairs(giveRows) do
		keys[normKey(r.name)] = true
	end
	for _, r in ipairs(takeRows) do
		keys[normKey(r.name)] = true
	end
	state.evalKeys = keys

	local approxCount = 0
	for _, r in ipairs(giveRows) do
		if r.approx then
			approxCount = approxCount + 1
		end
	end
	for _, r in ipairs(takeRows) do
		if r.approx then
			approxCount = approxCount + 1
		end
	end

	T.give.count.Text = string.format("%d item%s", #giveList, #giveList == 1 and "" or "s")
	T.take.count.Text = string.format("%d item%s", #takeList, #takeList == 1 and "" or "s")
	T.give.total.Text = fmt(giveRaw)
	T.take.total.Text = fmt(takeRaw)
	T.give.count.TextColor3 = #giveList > 0 and C.dim or C.faint
	T.take.count.TextColor3 = #takeList > 0 and C.dim or C.faint
	T.give.total.TextColor3 = #giveList > 0 and C.blue or C.faint
	T.take.total.TextColor3 = #takeList > 0 and C.green or C.faint

	T.give.accepted.Text = sides.myAccepted and "you accepted ✓" or "you have not accepted"
	T.give.accepted.TextColor3 = sides.myAccepted and C.green or C.faint
	T.take.accepted.Text = sides.theirAccepted and "they accepted ✓" or "waiting for them to accept"
	T.take.accepted.TextColor3 = sides.theirAccepted and C.green or C.faint

	local maxValue = math.max(giveRaw, takeRaw, 1)
	H.setBar(T.giveFill, giveRaw, maxValue)
	H.setBar(T.takeFill, takeRaw, maxValue)
	setMeter(giveRaw, takeRaw)
	T.giveBarValue.Text = fmt(giveRaw)
	T.takeBarValue.Text = fmt(takeRaw)

	local unpriced = giveUnpriced + takeUnpriced

	if giveW <= 0 and takeW <= 0 then
		paintVerdict(#giveList + #takeList > 0 and "NO PRICES" or "WAITING FOR ITEMS", C.dim, C.panelHi, C.line)
		T.sub.Text = VALUES.count == 0
			and "import your values in the VALUES tab to get a verdict"
			or "put something on either side"
		T.sub.TextColor3 = C.faint
		T.tag.Text = ""
		T.gap.Text = ""
		T.note.Text = unpriced > 0
			and string.format("%d item(s) have no exact entry in your value table", unpriced)
			or "no priced items on the table yet"
		T.note.TextColor3 = unpriced > 0 and C.amber or C.faint
		return
	end

	local ratio
	if giveW <= 0 then
		ratio = 4
	elseif takeW <= 0 then
		ratio = 0
	else
		ratio = takeW / giveW
	end

	local verdict, color, tint
	if ratio >= 1.15 then
		verdict, color, tint = "GOOD TRADE", C.green, Color3.fromRGB(19, 42, 33)
	elseif ratio <= 0.87 then
		verdict, color, tint = "BAD TRADE", C.red, Color3.fromRGB(64, 18, 26)
	else
		verdict, color, tint = "FAIR TRADE", C.amber, Color3.fromRGB(58, 36, 20)
	end

	local percent = math.floor((ratio - 1) * 100 + 0.5)
	local diff = takeW - giveW

	paintVerdict(verdict, color, tint)

	T.tag.Text = string.format("%s%d%%%s", percent >= 0 and "+" or "", percent, unpriced > 0 and "  (incomplete)" or "")
	T.tag.TextColor3 = color

	if diff >= 0 then
		T.gap.Text = "you gain " .. fmt(math.floor(diff + 0.5))
		T.gap.TextColor3 = C.green
	else
		T.gap.Text = "you lose " .. fmt(math.floor(-diff + 0.5))
		T.gap.TextColor3 = C.red
	end

	T.sub.Text = string.format(
		"give %s  ·  receive %s   (demand-weighted %s vs %s)",
		fmt(giveRaw), fmt(takeRaw), fmt(math.floor(giveW + 0.5)), fmt(math.floor(takeW + 0.5))
	)
	T.sub.TextColor3 = C.dim

	local notes = {}
	if ratio < 1.15 and giveW > 0 then
		local target = math.floor(giveW * 1.15 - takeW + 0.5)
		if diff < 0 then
			notes[#notes + 1] = string.format("need ~%s more to break even, ~%s for a good trade — see ADDS tab",
				fmt(math.floor(-diff + 0.5)), fmt(target))
		else
			notes[#notes + 1] = string.format("fair deal - ~%s more makes it a good trade", fmt(target))
		end
	elseif ratio >= 1.15 then
		notes[#notes + 1] = "their side is worth more"
	end
	if unpriced > 0 then
		notes[#notes + 1] = string.format("%d item(s) have no exact entry in your value table (counted as 0)", unpriced)
	end
	if approxCount > 0 then
		notes[#notes + 1] = string.format("%d item(s) valued from the closest name match", approxCount)
	end
	T.note.Text = table.concat(notes, "  ·  ")
	T.note.TextColor3 = (diff < 0 or unpriced > 0 or approxCount > 0) and C.amber or C.faint
end

