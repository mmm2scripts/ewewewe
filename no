		V.status.TextColor3 = C.red
		renderPreview()
		return false
	end

	cacheValues()
	if not silent then
		saveRaw(text)
	end
	renderPreview()
	H.paintMatchInfo()

	V.status.Text = string.format(
		"%d items · %d categories · loaded from %s%s",
