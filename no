function H.deepDescribe(value, depth)
	depth = depth or 0
	if type(value) ~= "table" then
		local s = tostring(value)
		if #s > 60 then
			s = string.sub(s, 1, 60) .. "..."
		end
		if type(value) == "string" then
			return '"' .. s .. '"'
		end
		return s
	end
	if depth >= 5 then
		return "{...}"
	end

	local parts = {}
	local n = 0
	for k, v in pairs(value) do
		n = n + 1
		if n > 14 then
			parts[#parts + 1] = "..."
			break
		end
		parts[#parts + 1] = tostring(k) .. "=" .. H.deepDescribe(v, depth + 1)
	end
	return "{" .. table.concat(parts, ", ") .. "}"
end

function H.listText(list)
	local bits = {}
	for _, e in ipairs(list or {}) do
		bits[#bits + 1] = e.name .. " x" .. e.qty
	end
	return #bits > 0 and table.concat(bits, ", ") or "-"
end

local function buildDebugText()
	local out = {}
	local function line(s)
		out[#out + 1] = s
	end

	local st, info, packed = getStatus()
	line("status      = " .. tostring(st))
	line("version     = " .. SCRIPT_VERSION)
	line("error       = " .. (state.lastError ~= "" and state.lastError or "-"))
	line("values      = " .. VALUES.count .. " items, " .. VALUES.categories .. " categories")
	line("owned       = " .. OWNED.count .. " item types (" .. OWNED.source .. ")" .. (OWNED.guiOnly and "  [GUI names only, quantity not read]" or ""))
	line("background  = " .. (bgImage.Visible and "shown" or "not shown") .. "  src=" .. tostring(SETTINGS.bgUrl))
	line("style       = dim " .. H.pct(SETTINGS.bgDim) .. ", panels " .. H.pct(SETTINGS.panelOpacity)
		.. ", crest " .. (SETTINGS.horns and "on" or "off") .. " (" .. SETTINGS.hornColor .. ")")
	line("shading     = panel " .. H.pct(SETTINGS.shadePanel) .. ", button " .. H.pct(SETTINGS.shadeButton)
		.. ", vignette " .. H.pct(SETTINGS.shadeVignette) .. ", crest glow " .. H.pct(SETTINGS.shadeHorn)
		.. ", glow " .. H.pct(SETTINGS.shadeGlow) .. ", cracks " .. H.pct(SETTINGS.shadeCracks)
		.. ", border " .. H.px(SETTINGS.borderThick))
	line("matching    = " .. (SETTINGS.matchFuzzy and "closest" or "exact only")
		.. ", same rarity " .. (SETTINGS.matchSameRarity and "yes" or "no")
		.. ", strength " .. H.pct(SETTINGS.matchThreshold))
	line("weapons db  = " .. (next(WeaponsDB) ~= nil and "loaded" or "NOT loaded (names/icons fall back)"))
	line("events      = " .. state.events)
	line("returns     = " .. tostring(packed and packed.n or 0))
	if packed then
		for i = 1, (packed.n or 0) do
			line(string.format("  [%d: %s] %s", i, typeof(packed[i]), H.deepDescribe(packed[i])))
		end
	end

	line("")
	line("-- info top level --")
	if type(info) == "table" then
		local keys = {}
		for k in pairs(info) do
			keys[#keys + 1] = k
		end
		table.sort(keys, function(a, b)
			return tostring(a) < tostring(b)
		end)
		for _, k in ipairs(keys) do
			line(string.format("%s (%s) = %s", tostring(k), typeof(info[k]), H.deepDescribe(info[k], 1)))
		end
	else
		line("info = " .. tostring(info))
	end

	line("")
	line("-- sides decoded --")
	local sides = findSides(info)
	if sides then
		line("me   = " .. tostring(sides.myName) .. "   accepted=" .. tostring(sides.myAccepted))
		line("them = " .. tostring(sides.theirName) .. "   accepted=" .. tostring(sides.theirAccepted))
		line("give = " .. H.listText(decodeOffer(sides.mine)))
		line("get  = " .. H.listText(decodeOffer(sides.theirs)))

		line("")
		line("-- item values (exact vs closest; kind / year / event as read from the id) --")
		local seen = {}
		for _, list in ipairs({ decodeOffer(sides.mine), decodeOffer(sides.theirs) }) do
			for _, e in ipairs(list) do
				if not seen[e.dataID] then
					seen[e.dataID] = true
					local entry, match = valueFor(e.dataID, e.name)
					local how = "no value"
					if entry then
						how = match and match.exact and string.format("exact -> %s [%s]", entry.name, tostring(entry.rarity))
							or string.format("closest %d%% -> %s [%s]",
								math.floor((match and match.score or 0) * 100 + 0.5),
								match and match.matched or entry.name, tostring(entry.rarity))
					end
					line(string.format("%s  [%s]  game rarity %s  kind %s  year %s  event %s  %s",
						e.name, e.dataID, tostring(e.rarity), tostring(H.weaponKind(e.dataID) or "-"),
						tostring(e.year or "-"), tostring(e.event or "-"), how))
				end
			end
		end

		line("")
		line("-- item icons (send me this if images are missing) --")
		local seenIcon = {}
		for _, list in ipairs({ decodeOffer(sides.mine), decodeOffer(sides.theirs) }) do
			for _, e in ipairs(list) do
				if not seenIcon[e.dataID] then
					seenIcon[e.dataID] = true
					local icon = iconFor(e.dataID, e.name)
					line(string.format("%s  [%s]  icon=%s", e.name, e.dataID, tostring(icon)))
					local meta = WeaponsDB[e.dataID]
					if type(meta) == "table" then
						local bits, n = {}, 0
						for k, v in pairs(meta) do
							n = n + 1
							if n > 26 then
								break
							end
							bits[#bits + 1] = tostring(k) .. "=" .. H.deepDescribe(v, 4)
						end
						line("    meta: " .. table.concat(bits, ", "))
					else
						line("    meta: none (not in Database.Sync.Weapons)")
					end
				end
			end
		end
	else
		line("no Player1/Player2 shape in this payload")
	end

	line("")
	line("-- trade accept button (TradeGUI.Container.Trade.Actions.Accept) --")
	do
		local n = LocalPlayer:FindFirstChild("PlayerGui")
		for _, nm in ipairs({ "TradeGUI", "Container", "Trade", "Actions", "Accept" }) do
			n = n and n:FindFirstChild(nm)
		end
		if n then
			line(string.format("Accept  %s  visible=%s", n.ClassName, tostring(n:IsA("GuiObject") and n.Visible)))
			for _, nm in ipairs({ "Cooldown", "Confirm", "Cancel" }) do
				local c = n:FindFirstChild(nm)
				line(string.format("  %s  %s", nm, c and (c.ClassName .. "  visible=" .. tostring(c:IsA("GuiObject") and c.Visible)) or "not found"))
			end
		else
			line("not found (the trade GUI is probably not open)")
		end
	end

	line("")
	line("-- inventory detection (what was tried) --")
	do
		line("source = " .. tostring(OWNED.source))
		if #OWNED.tried == 0 then
			line("(no remote was tried yet - press REFRESH in the INV tab)")
		end
		for _, t in ipairs(OWNED.tried) do
			line(string.format("  %s -> %s", t.label, t.n < 0 and "no answer" or (t.n .. " items")))
		end
	end

	line("")
	line("-- owned items (first 40; kind / year / event read from the id) --")
	do
		local n = 0
		for id, qty in pairs(OWNED.map) do
			n = n + 1
			if n > 40 then
				line("...")
				break
			end
			line(string.format("%s [%s] x%d  kind %s  year %s  event %s", (itemLabel(id)), id, qty,
				tostring(H.weaponKind(id) or "-"), tostring(H.yearFrom(tostring(id)) or "-"), tostring(H.idEvent(id) or "-")))
		end
		if n == 0 then
			line("(none read - press MY ITEMS in the ADDS tab or REFRESH in the INV tab)")
		end
	end

	line("")
	line("-- raw item records --")
	if type(info) == "table" then
		local found = 0
		local function probe(node, path, depth)
			if type(node) ~= "table" or depth > 6 or found > 60 then
				return
			end
			if type(node[1]) == "string" and type(node[2]) == "number" then
				found = found + 1
				line(string.format("%s  tuple { dataID=%s, amount=%s, type=%s }",
					path, tostring(node[1]), tostring(node[2]), tostring(node[3])))
			elseif node.DataID ~= nil then
				found = found + 1
				line(string.format("%s  DataID=%s Amount=%s", path, tostring(node.DataID), tostring(node.Amount)))
			end
			for k, v in pairs(node) do
				if type(v) == "table" then
					probe(v, path .. "." .. tostring(k), depth + 1)
				end
			end
		end
		probe(info, "info", 0)
		if found == 0 then
			line("(nothing item-shaped in this payload)")
		end
	end

	line("")
	line("-- recent log --")
	for i = math.max(1, #logHistory - 20), #logHistory do
		if logHistory[i] then
			line(logHistory[i])
		end
	end

	return table.concat(out, "\n")
end

