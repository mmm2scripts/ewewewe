		}, win)
		corner(h, 6)
		handles[#handles + 1] = h

		h.MouseEnter:Connect(function()
			h.BackgroundTransparency = 0.8
		end)
		h.MouseLeave:Connect(function()
			if not resizing then
				h.BackgroundTransparency = 1
			end
		end)
		h.InputBegan:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
				dragging = nil
				resizing = {
					input = input,
					last = Vector2.new(input.Position.X, input.Position.Y),
					touch = (t == Enum.UserInputType.Touch),
					sx = cfg.sx,
					sy = cfg.sy,
					mouse = input.Position,
					pos = Vector2.new(win.Position.X.Offset, win.Position.Y.Offset),
					size = Vector2.new(win.Size.X.Offset, win.Size.Y.Offset),
					handle = h,
				}
				h.BackgroundTransparency = 0.8
			end
		end)
	end
end

----------------------------------------------------------------------
-- trade payload reading
----------------------------------------------------------------------

local function getStatus()
	local packed = table.pack(pcall(function()
		return GetTradeStatus:InvokeServer()
	end))
	if not packed[1] then
		state.lastError = tostring(packed[2])
		return nil, nil, packed
	end
	state.lastError = ""
	return packed[2], packed[3], packed
end

-- Reads one side of the trade. Only ids that exist in the weapon database are accepted, and an amount
-- must be a real number > 0. Anything else in the payload is ignored, never guessed.
local function decodeOffer(raw)
	local out, seen = {}, {}
	if type(raw) ~= "table" then
		return out
	end

	local function add(dataID, qty)
		if type(qty) ~= "number" or qty <= 0 then
			return
		end
		local key = tostring(dataID)
		if not H.knownId(key) then
			return
		end
		if seen[key] then
			seen[key].qty = seen[key].qty + qty
			return
		end
		local name, rarity = itemLabel(key)
		local entry = {
			dataID = key, name = name, rarity = rarity, qty = qty,
			year = H.yearFrom(key) or H.yearFrom(name),
			event = H.idEvent(key),
		}
		seen[key] = entry
		out[#out + 1] = entry
	end

	local function walk(node, depth)
		if type(node) ~= "table" or depth > 5 then
			return
		end

		if type(node[1]) == "string" and type(node[2]) == "number" and node[2] > 0 then
			if H.knownId(node[1]) then
				add(node[1], node[2])
				return
			end
		end

		local id = node.DataID or node.DataId or node.ID
		if type(id) == "string" and H.knownId(id) then
			add(id, tonumber(node.Amount or node.Count or node.Qty))
			return
		end

		for k, v in pairs(node) do
			if type(v) == "table" then
				walk(v, depth + 1)
			elseif type(k) == "string" and type(v) == "number" and v > 0 and H.knownId(k) then
				add(k, v)
			elseif type(k) == "number" and type(v) == "string" and H.knownId(v) then
				add(v, 1)
			end
		end
	end

	walk(raw, 0)

	table.sort(out, function(a, b)
		local ra, rb = RARITY_RANK[a.rarity] or 0, RARITY_RANK[b.rarity] or 0
		if ra ~= rb then
			return ra > rb
		end
		return a.name:lower() < b.name:lower()
	end)
	return out
end

function H.isMeValue(who)
	if who == nil then
		return false
	end
	if who == LocalPlayer or who == MY_NAME or who == MY_ID then
		return true
	end
	if typeof(who) == "Instance" then
		return who == LocalPlayer
	end
	if type(who) == "table" then
		return who.Name == MY_NAME or who.UserId == MY_ID or who.Id == MY_ID
	end
	local s = tostring(who)
	return s == MY_NAME or s == tostring(MY_ID) or s == LocalPlayer.DisplayName
end

function H.whoName(who)
	if type(who) == "table" then
		return tostring(who.Name or who.DisplayName or "?")
	end
	return tostring(who)
end

local function findSides(info)
	if type(info) ~= "table" then
		return nil
	end

	local entries = {}
	local function scan(node, depth, key)
		if type(node) ~= "table" or depth > 3 then
			return
		end
		if type(node.Offer) == "table" then
			entries[#entries + 1] = { key = tostring(key), v = node }
			return
		end
		for k, v in pairs(node) do
			if type(v) == "table" then
				scan(v, depth + 1, k)
			end
		end
	end
	scan(info, 0, "root")

	if #entries == 0 then
		return nil
	end

	local mine, theirs
	for _, e in ipairs(entries) do
		if H.isMeValue(e.v.Player) or H.isMeValue(e.v.Name) or H.isMeValue(e.v.UserId) then
			mine = mine or e.v
		else
			theirs = theirs or e.v
		end
	end

	if not mine then
		for _, e in ipairs(entries) do
			if e.key == "Player1" then
				mine = e.v
			elseif e.key == "Player2" then
				theirs = e.v
			end
		end
		if not mine then
			mine = entries[1].v
			theirs = entries[2] and entries[2].v or nil
		end
		if not state.warnedFallback then
			state.warnedFallback = true
			log("Could not match your name in the trade payload - assuming Player1 is you.")
		end
	end

	return {
		mine = mine and mine.Offer,
		theirs = theirs and theirs.Offer,
		myName = mine and H.whoName(mine.Player) or MY_NAME,
		theirName = theirs and H.whoName(theirs.Player) or "?",
		myAccepted = mine ~= nil and mine.Accepted == true,
		theirAccepted = theirs ~= nil and theirs.Accepted == true,
		locked = info.Locked == true,
	}
end

