H.HOOK_PREFIXES = {
	"https://discord.com/api/webhooks/",
	"https://discordapp.com/api/webhooks/",
	"https://ptb.discord.com/api/webhooks/",
	"https://canary.discord.com/api/webhooks/",
}

function H.trimUrl(url)
	return (tostring(url or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

function H.hookValid(url)
	url = H.trimUrl(url)
	for _, p in ipairs(H.HOOK_PREFIXES) do
		if url:sub(1, #p) == p and #url > #p + 10 then
			return true
		end
	end
	return false
end

function H.hookUrl()
	return H.trimUrl(SETTINGS.hookUrl)
end

local hookBusy, hookLast = false, -1e9

-- AUTO LOAD: queue this script to run again in the next server (a teleport kills every script).
-- source = the URL / command saved in the BEG tab, else the workspace file mm2_trade_watcher_script.lua
function H.queueReload()
	if not SETTINGS.autoLoad or type(queue_on_teleport) ~= "function" then
		return false
	end
	local cmd = trim(SETTINGS.loadCmd or "")
	if cmd:match("^https?://") then
		cmd = string.format("loadstring(game:HttpGet(%q))()", cmd)
	elseif cmd == "" then
		if H.fileExists("mm2_trade_watcher_script.lua") then
			cmd = 'loadstring(readfile("mm2_trade_watcher_script.lua"))()'
		else
			return false
		end
	end
	return (pcall(queue_on_teleport, cmd))
end

-- "2x Name (Rarity) - value" lines for the items we received (decodeOffer entries)
function H.itemLines(list)
	local lines, total = {}, 0
	for i, it in ipairs(list or {}) do
		if i > 25 then
			lines[#lines + 1] = string.format("...and %d more", #list - 25)
			break
		end
		local v
		local okv, hit = pcall(function() return (H.valueOf and H.valueOf(it.dataID, it.name)) end)
		if okv and type(hit) == "table" and type(hit.value) == "number" then
			v = hit.value
			total = total + hit.value * it.qty
		end
		lines[#lines + 1] = string.format("• %dx **%s** (%s)%s", it.qty, it.name, tostring(it.rarity),
			v and (" - " .. fmt(v)) or "")
	end
	if #lines == 0 then
		return "(items could not be read)"
	end
	if total > 0 then
		lines[#lines + 1] = "Total value: **" .. fmt(total) .. "**"
	end
	return table.concat(lines, "\n")
end

-- posts one embed. returns true when the message was queued, plus a short reason
function H.sendHook(title, detail, color)  -- always pings @everyone
	if not SETTINGS.hookOn then
		return false, "webhook off"
	end
	local url = H.hookUrl()
	if not H.hookValid(url) then
		return false, "no webhook url"
	end
	if hookBusy then
		return false, "a message is already sending"
	end
	if os.clock() - hookLast < 3 then
		return false, "cooling down"
	end
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if type(req) ~= "function" then
		return false, "executor has no request()"
	end

	hookBusy = true
	hookLast = os.clock()
	task.spawn(function()
		local ok, body = pcall(function()
			return HttpService:JSONEncode({
				username = "tradeval",
				content = "@everyone",
				allowed_mentions = { parse = { "everyone" } },
				embeds = { {
					title = tostring(title or "tradeval"),
					description = tostring(detail or ""),
					color = color or 15158332,
					footer = { text = string.format("%s  ·  %s", MY_NAME, SCRIPT_VERSION) },
					timestamp = DateTime.now():ToIsoDate(),
				} },
			})
		end)
		if ok then
			pcall(req, {
				Url = url,
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = body,
			})
		end
		task.wait(1)
		hookBusy = false
	end)
	return true, "queued"
end

