local OWN={map={},count=0,at=-100,source="not loaded",busy=false,tried={},guiOnly=false}
local ORM={{"Remotes","Extras","GetFullInventory"},{"Remotes","Inventory","GetProfileData"},{"Remotes","Extras","GetProfileData"},{"Remotes","Inventory","GetFullInventory"},{"Remotes","Extras","GetInventory"}}
local function candidates()
	local list,seen={},{}
	local function add(r,l) if r and r:IsA("RemoteFunction") and not seen[r] then seen[r]=true; list[#list+1]={remote=r,label=l} end end
	for _,p in ipairs(ORM) do
		local n=RS
		for _,x in ipairs(p) do n=n and n:FindFirstChild(x) end
		add(n,table.concat(p,"."))
	end
	pcall(function()
		for _,d in ipairs(RS:GetDescendants()) do
			if d:IsA("RemoteFunction") then
				local ln=d.Name:lower()
				for _,h in ipairs({"inventory","profile","owned"}) do
					if ln:find(h,1,true) then add(d,(d:GetFullName():gsub("^ReplicatedStorage%.",""))) break end
				end
			end
		end
	end)
	return list
end
local function invoke(remote,limit,...)   -- RemoteFunction call that can never hang
	local args=table.pack(...); local done,ok,res=false,false,nil
	task.spawn(function() ok,res=pcall(function() return remote:InvokeServer(table.unpack(args,1,args.n)) end); done=true end)
	local w=0
	while not done and w<limit do task.wait(.1); w=w+.1 end
	if done and ok then return res end
end
local function isItem(id) return type(id)=="string" and DB[id]~=nil end
local function parsePayload(root)
	local out,vis={},{}
	local function add(id,q)   -- amount must be a real number >= 1, never assumed
		if type(q)~="number" or q~=q then return end
		q=math.floor(q); if q<1 then return end
		out[id]=(out[id] or 0)+q
	end
	local function walk(n,d)
		if type(n)~="table" or d>7 or vis[n] then return end
		vis[n]=true
		if isItem(n[1]) and type(n[2])=="number" then add(n[1],n[2]) return end
		local rid=n.DataID or n.DataId or n.ItemID or n.ItemId
		if isItem(rid) then add(rid,n.Amount or n.Count or n.Qty or n.Quantity) return end
		for k,v in pairs(n) do
			if isItem(k) and type(v)=="number" and v>0 then add(k,v)
			elseif isItem(k) and type(v)=="table" then add(k,v.Amount or v.Count or v.Qty or v.Quantity)
			elseif type(k)=="number" and isItem(v) then add(v,1)
			elseif type(v)=="table" then walk(v,d+1) end
		end
	end
	local start=root
	if type(root)=="table" then
		if type(root.Weapons)=="table" then start=type(root.Weapons.Owned)=="table" and root.Weapons.Owned or root.Weapons
		elseif type(root.Owned)=="table" then start=root.Owned end
	end
	walk(start,0)
	if next(out)==nil and start~=root then vis={}; walk(root,0) end
	return out
end
local function isShown(i)
	local n=i
	while n and n~=PG do
		if n:IsA("GuiObject") and not n.Visible then return false end
		if n:IsA("ScreenGui") and not n.Enabled then return false end
		n=n.Parent
	end
	if i:IsA("GuiObject") then local s=i.AbsoluteSize if s.X<=0 or s.Y<=0 then return false end end
	return true
end
local function detectFromGui()   -- visible item names only, unique names only, quantities NOT read
	local out,idx={},getIdByKey()
	pcall(function()
		for _,d in ipairs(PG:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text~="" and #d.Text<40 and isShown(d) then
				local id=idx[nk(d.Text)]
				if id then out[id]=1 end
			end
		end
	end)
	return out
end
local function detectInventory()   -- call from a task.spawn
	local rep={source="none",tried={},guiOnly=false}
	local best,bn=nil,0
	for _,c in ipairs(candidates()) do
		for _,arg in ipairs({"none","name"}) do
			local res
			if arg=="none" then res=invoke(c.remote,4) else res=invoke(c.remote,4,MY_NAME) end
			if type(res)=="table" then
				local m=parsePayload(res); local n=countKeys(m)
				rep.tried[#rep.tried+1]={label=c.label.." ("..arg..")",n=n}
				if n>bn then best,bn=m,n; rep.source=c.label end
			else rep.tried[#rep.tried+1]={label=c.label.." ("..arg..")",n=-1} end
			if bn>0 then break end
		end
		if bn>0 then break end
	end
	if best then return best,rep end
	local g=detectFromGui()
	if countKeys(g)>0 then rep.source="inventory GUI (visible names only, quantities not read)"; rep.guiOnly=true; return g,rep end
	return nil,rep
end
local function refreshOwned(cb)
	if OWN.busy then return end
	OWN.busy=true
	task.spawn(function()
		local ok,map,rep=pcall(detectInventory)
		if not ok then rep={source="detection error: "..tostring(map),tried={}}; map=nil end
		OWN.tried=rep and rep.tried or {}
		if map then
			OWN.map,OWN.count,OWN.source,OWN.guiOnly=map,countKeys(map),rep.source,rep.guiOnly==true
			log(string.format("Inventory read: %d owned item types (%s).",OWN.count,OWN.source))
		else
			OWN.source=(rep and rep.source~="none") and rep.source or "none of the inventory remotes answered and no inventory GUI was found"
			log("Could not read your inventory - "..OWN.source)
		end
		OWN.at=os.clock(); OWN.busy=false
		if cb then pcall(cb) end
	end)
end

