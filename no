-- s = wallpaper darkness; the vignette setting controls how much darker the edges are than the middle
local function applyDim(s)
	s = math.clamp(s, 0, 1)
	local v = math.clamp(SETTINGS.shadeVignette, 0, 1)
	local function tr(opacity)
		return math.clamp(1 - opacity, 0, 1)
	end
	local mid = 0.10 + 0.56 * s
	local top = mid + (0.70 + 0.36 * s - mid) * v
	local bot = mid + (0.60 + 0.44 * s - mid) * v
	overlayGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0.00, tr(top)),
		NumberSequenceKeypoint.new(0.45, tr(mid)),
		NumberSequenceKeypoint.new(1.00, tr(bot)),
	})
end
H.regShade("vignette", function()
	applyDim(SETTINGS.bgDim)
end)

