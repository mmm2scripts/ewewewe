---------------------------------------------------------------- OLD PLACE IDS (visited servers, saved with writefile / read with readfile)
-- NOTE: every MM2 server shares the same game.PlaceId, only game.JobId differs per server.
-- With TRACK_JOBID=true each entry is "PlaceId_JobId" so only an actually-repeated SERVER counts as visited.
-- Set TRACK_JOBID=false for the literal behaviour (PlaceId only) - then every MM2 server after the first counts as "visited" and the script hops forever.
local TRACK_JOBID=true
local MAX_PLACES=300
local OldPlaceIds={list={}}
function OldPlaceIds.key(placeId,jobId)
	local k=tostring(placeId or game.PlaceId)
	if TRACK_JOBID then k=k.."_"..tostring(jobId or game.JobId) end
	return k
end
function OldPlaceIds.read()   -- always re-reads the file (readfile)
	local list={}
	local ok,d=pcall(function()
		if type(isfile)=="function" and type(readfile)=="function" and isfile(F_PLACES) then return HS:JSONDecode(readfile(F_PLACES)) end
	end)
	if ok and type(d)=="table" then
		for _,e in ipairs(d) do if type(e)=="table" and type(e.key)=="string" then list[#list+1]=e end end
	end
	OldPlaceIds.list=list
	return list
end
function OldPlaceIds.has(key)
	for _,e in ipairs(OldPlaceIds.read()) do if e.key==key then return true end end
	return false
end
function OldPlaceIds.write()   -- writefile
	if type(writefile)~="function" then return false end
	return (pcall(function() writefile(F_PLACES,HS:JSONEncode(OldPlaceIds.list)) end))
end
function OldPlaceIds.add(key)
	local list=OldPlaceIds.list
	list[#list+1]={key=key,placeId=game.PlaceId,jobId=game.JobId,at=os.time()}
	while #list>MAX_PLACES do table.remove(list,1) end
	return OldPlaceIds.write()
end
function OldPlaceIds.clear()
	OldPlaceIds.list={}
	return OldPlaceIds.write()
end

