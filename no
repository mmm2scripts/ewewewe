function H.invRender(force)
	local I = H.INV
	local filter = trim(I.search.Text):lower()
	local sig = table.concat({ I.sort, filter, tostring(OWNED.count), tostring(OWNED.at), tostring(VALUES.count),
		tostring(SETTINGS.matchFuzzy), tostring(SETTINGS.matchSameRarity), tostring(SETTINGS.matchThreshold) }, "|")
	if not force and sig == I.sig then
		return
	end
	I.sig = sig
	I.token = I.token + 1
	local my = I.token
	clearChildren(I.scroll)

	local function message(text, color)
		lbl({
			Size = UDim2.new(1, -8, 0, 44),
			TextColor3 = color or C.faint,
			TextWrapped = true,
			Text = text,
		}, I.scroll)
	end

	if OWNED.count == 0 then
		I.total.Text = "-"
		I.total.TextColor3 = C.faint
		I.sub.Text = OWNED.busy and "reading your inventory..." or "inventory not read"
		if OWNED.busy then
			message("Reading your inventory...")
		else
			message("Couldn't read your inventory (" .. tostring(OWNED.source)
				.. "). Press REFRESH to retry - the DEBUG tab shows what was found.", C.amber)
		end
		return
	end

	local rows, total, unpriced, items, approxCount = {}, 0, 0, 0, 0
	for id, qty in pairs(OWNED.map) do
		local name, rarity = itemLabel(id)
		local e, match = valueFor(id, name)
		if e and e.rarity and match and match.exact == true then
			rarity = e.rarity
		end
		local unit = e and e.value or 0
		items = items + qty
		local approx = match ~= nil and match.exact == false
		if e then
			total = total + unit * qty
			if approx then
				approxCount = approxCount + 1
			end
		else
			unpriced = unpriced + 1
		end
		rows[#rows + 1] = {
			dataID = id, name = name, rarity = rarity, qty = qty,
			year = H.yearFrom(tostring(id)) or H.yearFrom(name),
			event = H.idEvent(id),
			unit = unit, total = unit * qty,
			demand = e and e.demand or 5,
			stability = e and e.stability or "N/A",
			category = e and e.category or "",
			known = e ~= nil,
			approx = approx,
			matchPct = match and match.score and math.floor(match.score * 100 + 0.5) or nil,
			matchedName = match and match.matched or nil,
		}
	end

	I.total.Text = VALUES.count > 0 and fmt(total) or "no values loaded"
	I.total.TextColor3 = VALUES.count > 0 and C.amber or C.faint

	local shown = {}
	for _, r in ipairs(rows) do
		if filter == "" or r.name:lower():find(filter, 1, true)
			or r.rarity:lower():find(filter, 1, true) or r.category:lower():find(filter, 1, true)
			or (r.year and tostring(r.year):find(filter, 1, true))
			or (r.event and r.event:lower():find(filter, 1, true)) then
			shown[#shown + 1] = r
		end
	end

	table.sort(shown, function(a, b)
		if I.sort == "name" then
			return a.name:lower() < b.name:lower()
		elseif I.sort == "year" then
			-- newest first, items with no year last
			local ya, yb = a.year or 0, b.year or 0
			if ya ~= yb then
				return ya > yb
			end
			if a.total ~= b.total then
				return a.total > b.total
			end
			return a.name:lower() < b.name:lower()
		elseif I.sort == "rarity" then
			local ra, rb = RARITY_RANK[a.rarity] or 0, RARITY_RANK[b.rarity] or 0
			if ra ~= rb then
				return ra > rb
			end
			if a.total ~= b.total then
				return a.total > b.total
			end
			return a.name:lower() < b.name:lower()
		end
		if a.known ~= b.known then
			return a.known
		end
		if a.total ~= b.total then
			return a.total > b.total
		end
		return a.name:lower() < b.name:lower()
	end)

	I.sub.Text = string.format("%d item types · %d items%s%s%s%s", #rows, items,
		OWNED.guiOnly and " (GUI names only - quantity not read, counted as 1)" or "",
		unpriced > 0 and string.format(" · %d without an exact price", unpriced) or "",
		approxCount > 0 and string.format(" · %d closest-matched", approxCount) or "",
		#shown ~= #rows and string.format(" · showing %d", #shown) or "")

	if #shown == 0 then
		message("nothing matches that filter")
		return
	end

	-- built in batches so hundreds of items don't freeze the game
	task.spawn(function()
		for i, row in ipairs(shown) do
			if my ~= I.token or not gui.Parent then
				return
			end
			H.invCard(row, i, total)
			if i % 15 == 0 then
				task.wait()
			end
		end
	end)
end

