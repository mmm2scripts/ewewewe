-- swaps theme colours everywhere at once: ctx.retheme({ accent = Color3..., line = Color3... })
function H.retheme(map)
	local swaps = {}
	for key, col in pairs(map or {}) do
		if typeof(C[key]) == "Color3" and typeof(col) == "Color3" then
			swaps[#swaps + 1] = { C[key], col, key }
		end
	end
	local function swap(v)
		for _, s in ipairs(swaps) do
			if v == s[1] then
				return s[2]
			end
		end
		return nil
	end
	for _, d in ipairs(gui:GetDescendants()) do
		local n
		if d:IsA("GuiObject") then
			n = swap(d.BackgroundColor3)
			if n then
				d.BackgroundColor3 = n
			end
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				n = swap(d.TextColor3)
				if n then
					d.TextColor3 = n
				end
			end
		elseif d:IsA("UIStroke") then
			n = swap(d.Color)
			if n then
				d.Color = n
			end
		elseif d:IsA("UIGradient") then
			local kps, changed = {}, false
			for _, kp in ipairs(d.Color.Keypoints) do
				local c2 = swap(kp.Value)
				if c2 then
					changed = true
				end
				kps[#kps + 1] = ColorSequenceKeypoint.new(kp.Time, c2 or kp.Value)
			end
			if changed then
				d.Color = ColorSequence.new(kps)
			end
		end
	end
	for _, s in ipairs(swaps) do
		C[s[3]] = s[2]
	end
end

function H.resetTheme()
	local map = {}
	for k, v in pairs(H.ORIG_C) do
		map[k] = v
	end
	H.retheme(map)
end

