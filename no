-- crumbled crimson buttons (static - no animations)
----------------------------------------------------------------------

function H.crumble(btn)
	local seed = 11
	for i = 1, #btn.Text do
		seed = seed + btn.Text:byte(i) * (i + 3)
	end
	local rng = Random.new(seed)
	btn.ClipsDescendants = true

	local layer = new("Frame", {
		Name = "Crumble",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
	}, btn)

	local function crack(sx, sy, ang0, segs)
		local ox, oy, ang = 0, 0, ang0
		for i = 1, segs do
			local len = rng:NextInteger(5, 11)
			new("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(sx, ox, sy, oy + 1),
				Size = UDim2.fromOffset(len, 1),
				Rotation = ang,
				BackgroundColor3 = Color3.fromRGB(255, 84, 100),
				BackgroundTransparency = 0.78,
				BorderSizePixel = 0,
			}, layer)
			new("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(sx, ox, sy, oy),
				Size = UDim2.fromOffset(len, 1),
				Rotation = ang,
				BackgroundColor3 = C.soot,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
			}, layer)

			local r = math.rad(ang)
			if i == 2 and rng:NextNumber() < 0.7 then
				new("Frame", {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(sx, ox, sy, oy),
					Size = UDim2.fromOffset(rng:NextInteger(4, 7), 1),
					Rotation = ang + rng:NextInteger(40, 80) * (rng:NextNumber() < 0.5 and -1 or 1),
					BackgroundColor3 = C.soot,
					BackgroundTransparency = 0.3,
					BorderSizePixel = 0,
				}, layer)
			end
			ox = ox + math.cos(r) * len
			oy = oy + math.sin(r) * len
			ang = ang + rng:NextInteger(-55, 55)
		end
	end

	crack(0.08 + rng:NextNumber() * 0.38, 0, rng:NextInteger(50, 120), 4)
	crack(0.5 + rng:NextNumber() * 0.4, 0, rng:NextInteger(60, 130), 3)
	crack(0.1 + rng:NextNumber() * 0.7, 1, rng:NextInteger(-130, -50), 3)

	local corners = { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }
	for _, c in ipairs(corners) do
		if rng:NextNumber() < 0.6 then
			local s = rng:NextInteger(5, 9)
			new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(c[1], c[2]),
				Size = UDim2.fromOffset(s, s),
				Rotation = rng:NextInteger(15, 75),
				BackgroundColor3 = C.bg,
				BackgroundTransparency = 0.05,
				BorderSizePixel = 0,
			}, layer)
		end
	end

	for _ = 1, 3 do
		local sp = new("Frame", {
			Position = UDim2.fromScale(0.06 + rng:NextNumber() * 0.88, 0.15 + rng:NextNumber() * 0.7),
			Size = UDim2.fromOffset(2, 2),
			BackgroundColor3 = rng:NextNumber() < 0.5 and C.ember or Color3.fromRGB(255, 70, 80),
			BackgroundTransparency = 0.3,
			BorderSizePixel = 0,
		}, layer)
		corner(sp, 1)
	end

	-- molten edge along the bottom (not part of the CRACKS setting)
	local lava = new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, layer)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.0, Color3.fromRGB(120, 12, 24)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 60)),
			ColorSequenceKeypoint.new(1.0, Color3.fromRGB(120, 12, 24)),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.85),
			NumberSequenceKeypoint.new(0.5, 0.35),
			NumberSequenceKeypoint.new(1, 0.85),
		}),
	}, lava)

	for _, f in ipairs(layer:GetChildren()) do
		if f:IsA("Frame") and not f:FindFirstChildOfClass("UIGradient") then
			H.addCrack(f)
		end
	end
end

-- Button text that stays readable.
-- A button's own text is drawn UNDER its child layers and is tinted by the button's UIGradient, so the
-- shading darkened the words and the crack layer was scribbled over them. faceText hides the real text
-- and mirrors it onto a brighter, outlined label that sits ABOVE every other layer of the button.
H.TEXT_STROKE = Color3.fromRGB(8, 0, 4)

function H.faceText(btn)
	local face = new("TextLabel", {
		Name = "Face",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
		ZIndex = 20,
		Font = Enum.Font.GothamBold,
		TextWrapped = false,
		TextStrokeColor3 = H.TEXT_STROKE,
		TextStrokeTransparency = 0.2,
	}, btn)

	local function sync()
		face.Text = btn.Text
		face.TextSize = btn.TextSize + 1
		face.TextColor3 = btn.TextColor3:Lerp(WHITE, 0.55)
		face.TextXAlignment = btn.TextXAlignment
		face.TextYAlignment = btn.TextYAlignment
		face.TextTruncate = btn.TextTruncate
		face.RichText = btn.RichText
	end

	-- the button's own TextTransparency stays at 1 (hidden); any value set on it is moved to the face
	local function pullTransparency()
		local t = btn.TextTransparency
		if t ~= 1 then
			face.TextTransparency = t
			face.TextStrokeTransparency = math.clamp(0.2 + t * 0.8, 0, 1)
			btn.TextTransparency = 1
		end
	end

	sync()
	pullTransparency()
	for _, prop in ipairs({ "Text", "TextSize", "TextColor3", "TextXAlignment", "TextYAlignment", "TextTruncate", "RichText" }) do
		btn:GetPropertyChangedSignal(prop):Connect(sync)
	end
	btn:GetPropertyChangedSignal("TextTransparency"):Connect(pullTransparency)
	return face
end

-- static crimson button look: shaded gradient, border and cracks. No animation of any kind.
local function polish(btn)
	local st = stroke(btn, C.accent, 1, 0.7)
	local g = new("UIGradient", { Rotation = 90 }, btn)
	H.shadeGrad("button", g, "shadeButton")
	H.crumble(btn)
	H.faceText(btn)
	-- instant (non-animated) border highlight so you can tell what you are pointing at
	btn.MouseEnter:Connect(function()
		st.Transparency = 0.2
	end)
	btn.MouseLeave:Connect(function()
		st.Transparency = 0.7
	end)
end

local function chip(parent, pos, w, h, text, bg, fg)
