local function recolorHorns(instant)
	local pal = hornPalette(SETTINGS.hornColor)
	local part = hornParts[1]
	if not part then
		return
	end
	local function paint(inst, prop, col)
		if instant then
			inst[prop] = col
		else
			tween(inst, { [prop] = col }, 0.25)
		end
	end
	for _, rec in ipairs(part.body) do
		paint(rec.f, "BackgroundColor3", pal.dark:Lerp(pal.light, rec.k))
	end
	for _, s in ipairs(part.rims) do
		paint(s, "Color", pal.light:Lerp(WHITE, 0.5))
	end
	paint(part.glow, "Color", pal.light)
	for _, g in ipairs(part.gems) do
		paint(g, "BackgroundColor3", pal.light:Lerp(WHITE, 0.6))
	end
	for _, j in ipairs(part.jewels) do
		paint(j, "BackgroundColor3", pal.light:Lerp(WHITE, 0.75))
	end
	for _, s in ipairs(part.sparks) do
		paint(s.f, "BackgroundColor3", pal.light:Lerp(WHITE, 0.7))
	end
end

local function clampWindow()
	if minimized then
		return
	end
	local vp = viewport()
	local minW, minH = minSize()
	local w = math.clamp(win.Size.X.Offset, minW, math.max(minW, vp.X))
	local h = math.clamp(win.Size.Y.Offset, minH, math.max(minH, vp.Y))
	local x = math.clamp(win.Position.X.Offset, -(w - 120), vp.X - 120)
	local y = math.clamp(win.Position.Y.Offset, H.TOP_LIM, math.max(H.TOP_LIM, vp.Y - 50))
	win.Size = UDim2.fromOffset(w, h)
	win.Position = UDim2.fromOffset(x, y)
end

