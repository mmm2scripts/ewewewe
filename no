local state={sig="",info=nil,open=false,giveW=nil,takeW=nil,keys={},events=0,lastGive={},lastTake={},verdict="WAITING FOR A TRADE",lastError="",warned=false}
local function getStatus()
	local p=table.pack(pcall(function() return GTS:InvokeServer() end))
	if not p[1] then state.lastError=tostring(p[2]); return nil,nil,p end
	state.lastError=""
	return p[2],p[3],p
end
local function decodeOffer(raw)   -- only ids in the weapon database, only real positive amounts
	local out,seen={},{}
	if type(raw)~="table" then return out end
	local function add(id,q)
		if type(q)~="number" or q<=0 then return end
		local k=tostring(id); if not knownId(k) then return end
		if seen[k] then seen[k].qty=seen[k].qty+q return end
		local nm,r=itemLabel(k)
		local e={dataID=k,name=nm,rarity=r,qty=q,year=yearFrom(k) or yearFrom(nm),event=idEvent(k)}
		seen[k]=e; out[#out+1]=e
	end
	local function walk(n,d)
		if type(n)~="table" or d>5 then return end
		if type(n[1])=="string" and type(n[2])=="number" and n[2]>0 and knownId(n[1]) then add(n[1],n[2]) return end
		local id=n.DataID or n.DataId or n.ID
		if type(id)=="string" and knownId(id) then add(id,tonumber(n.Amount or n.Count or n.Qty)) return end
		for k,v in pairs(n) do
			if type(v)=="table" then walk(v,d+1)
			elseif type(k)=="string" and type(v)=="number" and v>0 and knownId(k) then add(k,v)
			elseif type(k)=="number" and type(v)=="string" and knownId(v) then add(v,1) end
		end
	end
	walk(raw,0)
	table.sort(out,function(a,b)
		local ra,rb=RANK[a.rarity] or 0,RANK[b.rarity] or 0
		if ra~=rb then return ra>rb end
		return a.name:lower()<b.name:lower()
	end)
	return out
end
local function isMe(w)
	if w==nil then return false end
	if w==LP or w==MY_NAME or w==MY_ID then return true end
	if typeof(w)=="Instance" then return w==LP end
	if type(w)=="table" then return w.Name==MY_NAME or w.UserId==MY_ID or w.Id==MY_ID end
	local s=tostring(w); return s==MY_NAME or s==tostring(MY_ID) or s==LP.DisplayName
end
local function whoName(w) if type(w)=="table" then return tostring(w.Name or w.DisplayName or "?") end return tostring(w) end
local function findSides(info)
	if type(info)~="table" then return nil end
	local ents={}
	local function scan(n,d,key)
		if type(n)~="table" or d>3 then return end
		if type(n.Offer)=="table" then ents[#ents+1]={key=tostring(key),v=n} return end
		for k,v in pairs(n) do if type(v)=="table" then scan(v,d+1,k) end end
	end
	scan(info,0,"root")
	if #ents==0 then return nil end
	local mine,theirs
	for _,e in ipairs(ents) do
		if isMe(e.v.Player) or isMe(e.v.Name) or isMe(e.v.UserId) then mine=mine or e.v else theirs=theirs or e.v end
	end
	if not mine then
		for _,e in ipairs(ents) do if e.key=="Player1" then mine=e.v elseif e.key=="Player2" then theirs=e.v end end
		if not mine then mine=ents[1].v; theirs=ents[2] and ents[2].v or nil end
		if not state.warned then state.warned=true; log("Could not match your name in the trade payload - assuming Player1 is you.") end
	end
	return {mine=mine and mine.Offer,theirs=theirs and theirs.Offer,myName=mine and whoName(mine.Player) or MY_NAME,theirName=theirs and whoName(theirs.Player) or "?",
		myAccepted=mine~=nil and mine.Accepted==true,theirAccepted=theirs~=nil and theirs.Accepted==true,locked=info.Locked==true}
end

