function H.setStyleStatus(text, color)
	S.status.Text = text
	S.status.TextColor3 = color or C.dim
end

function H.httpGetBytes(url)
	local ok, res = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(res) == "string" and #res > 1000 then
		return res
	end
	local req = (syn and syn.request) or http_request or request or (http and http.request)
	if req then
		local ok2, r = pcall(req, { Url = url, Method = "GET" })
		if ok2 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 1000 then
			return r.Body
		end
	end
	return nil
end

function H.sniffExt(bytes)
	if bytes:sub(1, 8) == "\137PNG\r\n\26\n" then
		return "png"
	end
	if bytes:sub(1, 3) == "\255\216\255" then
		return "jpg"
	end
	if bytes:sub(1, 4) == "RIFF" and bytes:sub(9, 12) == "WEBP" then
		return "webp"
	end
	if bytes:sub(1, 3) == "GIF" then
		return "gif"
	end
	return nil
end

function H.hashStr(s)
	local h = 5381
	for i = 1, #s do
		h = (h * 33 + s:byte(i)) % 4294967296
	end
	return string.format("%08x", h)
end

function H.showImage(asset)
	bgImage.Image = asset
	bgImage.Visible = true
	S.preview.Image = asset
	S.previewEmpty.Visible = false
end

function H.hideImage()
	bgImage.Visible = false
	bgImage.Image = ""
	S.preview.Image = ""
	S.previewEmpty.Visible = true
end

local function rebuildRecent() end

function H.pushRecent(source)
	if source == BG_URL then
		return
	end
	local list = { source }
	for _, v in ipairs(SETTINGS.recent) do
		if v ~= source and #list < 6 then
			list[#list + 1] = v
		end
	end
	SETTINGS.recent = list
	rebuildRecent()
end

local bgToken = 0

local function applyBackground(source, quiet)
	bgToken = bgToken + 1
	local my = bgToken
	source = trim(source or "")
	if source == "" then
		H.setStyleStatus("type an image URL (png/jpg) or a file name from your executor workspace", C.amber)
		return
	end

	local getAsset = getcustomasset or getsynasset
	if type(getAsset) ~= "function" or type(writefile) ~= "function" then
		H.setStyleStatus("this executor has no getcustomasset / writefile, so wallpapers can't be used", C.red)
		log("Background skipped - this executor has no getcustomasset/writefile.")
		return
	end

	task.spawn(function()
		local file
		if source:match("^https?://") then
			local base = source == BG_URL and BG_FILE_BASE or ("mm2_tw_bg_" .. H.hashStr(source))
			for _, ext in ipairs({ "jpg", "png" }) do
				if H.fileExists(base .. "." .. ext) then
					file = base .. "." .. ext
					break
				end
			end
			if not file then
				H.setStyleStatus("downloading...", C.amber)
				local bytes = H.httpGetBytes(source)
				if my ~= bgToken then
					return
				end
				if not bytes then
					H.setStyleStatus("download failed - the site refused, or this executor has no HttpGet/request", C.red)
					log("Background download failed.")
					return
				end
				if #bytes > 12000000 then
					H.setStyleStatus("that image is too big (over 12 MB) - pick a smaller one", C.red)
					return
				end
				local ext = H.sniffExt(bytes)
				if ext ~= "png" and ext ~= "jpg" then
					H.setStyleStatus(ext
						and ("Roblox can't show ." .. ext .. " files - use a png or jpg")
						or "that link isn't a png/jpg image (it may be a web page - use the direct image link)", C.red)
					return
				end
				local name = base .. "." .. ext
				if not pcall(writefile, name, bytes) then
					H.setStyleStatus("couldn't save the image to your workspace", C.red)
					return
				end
				file = name
				log("Background downloaded (" .. #bytes .. " bytes).")
			end
		else
			if not H.fileExists(source) then
				H.setStyleStatus('no file called "' .. source .. '" in your executor workspace', C.red)
				return
			end
			file = source
		end

		local ok, asset = pcall(getAsset, file)
		if my ~= bgToken then
			return
		end
		if ok and asset and bgImage.Parent then
			SETTINGS.bgOn = true
			SETTINGS.bgUrl = source
			if not quiet then
				H.pushRecent(source)
				saveSettings()
			end
			H.showImage(asset)
			S.input.Text = source
			H.setStyleStatus("wallpaper applied", C.green)
		else
			H.setStyleStatus("the image downloaded but Roblox couldn't load it - try another one", C.red)
			log("Background asset could not be created from the cached file.")
		end
	end)
end

