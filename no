local function setHorns(on, instant)
	on = false   -- crest removed: always off
	SETTINGS.horns = on
	setChip(hornBtn, on)
	setChip(S.hornToggle, on)
	S.hornToggle.Text = "CREST OFF"
	hornRoot.Visible = false

	if on then
		hornRoot.Visible = true
	end
	FX.spikeLayer.Visible = false

	for _, part in ipairs(hornParts) do
		local pos = on and part.rest or part.hidden
		local sc = on and 1 or 0.55
		if instant then
			part.holder.Position = pos
			part.scale.Scale = sc
		else
			tween(part.holder, { Position = pos }, 0.32, Enum.EasingStyle.Back,
				on and Enum.EasingDirection.Out or Enum.EasingDirection.In)
			tween(part.scale, { Scale = sc }, 0.32, Enum.EasingStyle.Back,
				on and Enum.EasingDirection.Out or Enum.EasingDirection.In)
		end
		for _, rec in ipairs(part.all) do
			local target = on and rec.a or 1
			if instant then
				rec.f.BackgroundTransparency = target
			else
				tween(rec.f, { BackgroundTransparency = target }, 0.26)
			end
		end
	end
	if not on then
		local function hide()
			if not SETTINGS.horns then
				hornRoot.Visible = false
			end
		end
		if instant then
			hide()
		else
			task.delay(0.36, hide)
		end
	end
end

local function refreshSwatches()
	for name, sw in pairs(S.swatches) do
		sw.stroke.Transparency = name == SETTINGS.hornColor and 0 or 1
	end
end

