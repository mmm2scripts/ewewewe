local function destroyAll()
	for _, c in ipairs(connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(connections)
	gui:Destroy()
end

closeBtn.MouseButton1Click:Connect(destroyAll)

do
	local savedSize
	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
