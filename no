function H.stabPenalty(stab)
	local l = tostring(stab):lower()
	if l:find("underpaid") then
		return 0.03
	end
	if l:find("stable") then
		return 0
	end
	return 0.06
end

local function currentNeed()
	local custom = tonumber((trim(A.custom.Text):gsub(",", "")))
	if custom and custom > 0 then
		return custom, "custom target"
	end
	if not state.tradeOpen or not state.evalGiveW then
		return nil, "open a trade, or type a custom target value"
	end
	local g, t = state.evalGiveW, state.evalTakeW
	if A.mode == "ask" then
		local mult = A.goal == "good" and 1.15 or 1.0
		return g * mult - t, string.format("they should add ~%s more value for a %s trade",
			fmt(math.max(0, math.floor(g * mult - t + 0.5))), A.goal)
	end
	return t - g, string.format("you can add up to ~%s before it stops favouring you",
		fmt(math.max(0, math.floor(t - g + 0.5))))
end

