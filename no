local function makeSlider(parent, pos, size, minV, maxV, init, onChange, onCommit)
	local hit = new("TextButton", {
		Position = pos,
		Size = size,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, parent)
	local bar = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.new(1, -16, 0, 6),
		BackgroundColor3 = C.bg,
		BorderSizePixel = 0,
	}, hit)
	corner(bar, 3)
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.accent,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 3)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(150, 20, 40), Color3.fromRGB(255, 120, 70)),
	}, fill)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
	}, bar)
	corner(knob, 8)
	stroke(knob, C.accent, 2, 0)

	local api = { value = init }
	local active = false

	function api.set(v)
		api.value = math.clamp(v, minV, maxV)
		local a = (api.value - minV) / (maxV - minV)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
	end

	local function fromX(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		api.set(minV + (maxV - minV) * a)
		onChange(api.value)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			active = true
			fromX(input.Position.X)
		end
	end)
	track(UserInput.InputChanged:Connect(function(input)
		if active and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end))
	track(UserInput.InputEnded:Connect(function(input)
		if active and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
			active = false
			if onCommit then
				onCommit(api.value)
			end
		end
	end))

	api.set(init)
	return api
end

