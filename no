local function addCard(order, items, need)
	local n = #items
	local card = new("Frame", {
		Size = UDim2.new(1, -8, 0, 58),
		BackgroundColor3 = C.row,
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0,
		LayoutOrder = order,
	}, A.scroll)
	corner(card, 12)
	H.hoverable(card, 0.22)

	local x = 8
	local rawSum, wSum = 0, 0
	local names, subs = {}, {}
	for _, c in ipairs(items) do
		local rarity = "Other"
		if c.id then
			local _, r = itemLabel(c.id)
			rarity = r
		end
		local size = n == 1 and 44 or 34
		iconTile(card, x, n == 1 and 7 or 12, size, c.e.name, rarity, c.id)
		x = x + size + 4
		rawSum = rawSum + c.e.value
		wSum = wSum + c.w
		names[#names + 1] = c.e.name
		subs[#subs + 1] = string.format("D%s %s%s", fmtDemand(c.e.demand), tostring(c.e.stability),
			c.own and (" · you own x" .. c.own) or "")
	end
	local textX = x + 6

	lbl({
		Position = UDim2.fromOffset(textX, 7),
		Size = UDim2.new(1, -(textX + 118), 0, 16),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = table.concat(names, "  +  "),
	}, card)

	lbl({
		Position = UDim2.fromOffset(textX, 26),
		Size = UDim2.new(1, -(textX + 118), 0, 14),
		TextSize = 10,
		TextColor3 = C.dim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = n == 1 and (items[1].e.category .. " · " .. subs[1]) or table.concat(subs, "   |   "),
	}, card)

	lbl({
		Position = UDim2.new(1, -114, 0, 7),
		Size = UDim2.fromOffset(104, 16),
		Font = Enum.Font.Code,
		TextSize = 13,
		TextColor3 = C.amber,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = fmt(rawSum),
	}, card)

	local pctGap = math.floor(wSum / need * 100 + 0.5)
	local good = pctGap >= 97 and pctGap <= 130
	lbl({
		Position = UDim2.new(1, -114, 0, 27),
		Size = UDim2.fromOffset(104, 14),
		TextSize = 10,
		TextColor3 = good and C.green or C.amber,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = string.format("%d%% of the gap", pctGap),
	}, card)
end

local function refreshAdds(force)
	local need, desc = currentNeed()
	local filter = trim(A.search.Text):lower()
	local sig = table.concat({
		A.mode, A.goal, A.custom.Text, filter, state.sig, tostring(VALUES.count),
		tostring(need and math.floor(need) or "x"), tostring(OWNED.count), tostring(OWNED.at),
		tostring(SETTINGS.matchFuzzy), tostring(SETTINGS.matchSameRarity), tostring(SETTINGS.matchThreshold),
	}, "|")
	if not force and sig == A.sig then
		return
	end
	A.sig = sig

	clearChildren(A.scroll)
	A.info.Text = desc
	A.info.TextColor3 = C.dim
	A.hint.Text = (A.mode == "ask" and "they add" or "I add (items you own)") .. "  ·  " .. (A.goal == "good" and "good trade" or "fair trade")

	local function message(text)
		lbl({
			Size = UDim2.new(1, -8, 0, 44),
			TextColor3 = C.faint,
			TextWrapped = true,
			Text = text,
		}, A.scroll)
	end

	if VALUES.count == 0 then
		message("Import your values in the VALUES tab first - recommendations are picked from that table.")
		return
	end
	if not need then
		message("Open a trade and the gap will be calculated automatically, or type a custom target value above to find items and combos worth about that much.")
		return
	end
	if need <= 0 then
		A.info.TextColor3 = C.green
		message(A.mode == "ask"
			and "This trade already meets your target - nothing needs to be added."
			or "There's no room: this trade doesn't favour you enough to add anything.")
		return
	end

	local lo, hi, ratioT
	if A.mode == "ask" then
		lo, hi, ratioT = need * 0.97, need * 1.4, 1.08
	else
		lo, hi, ratioT = need * 0.5, need * 1.02, 0.95
	end
	if trim(A.custom.Text) ~= "" then
		lo, hi, ratioT = need * 0.85, need * 1.25, 1.03
	end

	local function matchesFilter(e, name)
		return filter == "" or name:lower():find(filter, 1, true) or e.category:lower():find(filter, 1, true)
	end

	local ids = getIdByKey()
	local cands = {}
	local ownedMode = A.mode == "give"

	if ownedMode and OWNED.count > 0 then
		for id, qty in pairs(OWNED.map) do
			local name = itemLabel(id)
			local e = valueFor(id, name)
			if e and e.value > 0 and not state.evalKeys[normKey(name)] and matchesFilter(e, name) then
				cands[#cands + 1] = { e = e, w = e.value * demandWeight(e.demand), id = id, own = qty }
			end
		end
	else
		if ownedMode then
			A.info.Text = "couldn't read your inventory - showing every item from the value table (press MY ITEMS to retry)"
			A.info.TextColor3 = C.amber
		end
		for _, e in ipairs(VALUES.list) do
			if e.value > 0 and not state.evalKeys[e.key] and matchesFilter(e, e.name) then
				cands[#cands + 1] = { e = e, w = e.value * demandWeight(e.demand), id = ids[e.key] }
			end
		end
	end

	local function penalty(c)
		return (10 - math.min(c.e.demand or 5, 10)) * 0.02 + H.stabPenalty(c.e.stability)
	end

	local singles = {}
	for _, c in ipairs(cands) do
		if c.w >= lo and c.w <= hi then
			singles[#singles + 1] = { items = { c }, score = math.abs(c.w / need - ratioT) + penalty(c) }
		end
	end
	table.sort(singles, function(a, b) return a.score < b.score end)

	local pool = {}
	for _, c in ipairs(cands) do
		if c.w >= need * 0.12 and c.w < hi then
			pool[#pool + 1] = c
		end
	end
	table.sort(pool, function(a, b) return a.w > b.w end)
	while #pool > 70 do
		table.remove(pool)
	end

	local combos = {}
	for i = 1, #pool do
		for j = i + 1, #pool do
			local a, b = pool[i], pool[j]
			local sum = a.w + b.w
			if sum >= lo and sum <= hi and a.e.name ~= b.e.name then
				combos[#combos + 1] = {
					items = { a, b },
					score = math.abs(sum / need - ratioT) + (penalty(a) + penalty(b)) / 2 + 0.05,
				}
			end
		end
	end
	table.sort(combos, function(a, b) return a.score < b.score end)

	local order = 0
	local shownSingles = math.min(#singles, 12)
	local shownCombos = math.min(#combos, 10)

	if shownSingles > 0 then
		order = order + 1
		H.addSection(string.format("SINGLE ITEMS  (%d)", shownSingles), order)
		for i = 1, shownSingles do
			order = order + 1
			addCard(order, singles[i].items, need)
		end
	end
	if shownCombos > 0 then
		order = order + 1
		H.addSection(string.format("TWO-ITEM COMBOS  (%d)", shownCombos), order)
		for i = 1, shownCombos do
			order = order + 1
			addCard(order, combos[i].items, need)
		end
	end
	if order == 0 then
		message((ownedMode and OWNED.count > 0 and "Nothing you own fits that gap" or "Nothing in your value table fits that gap")
			.. (filter ~= "" and " with this filter" or "")
			.. ". Try clearing the filter or switching FAIR / GOOD.")
	end
end

