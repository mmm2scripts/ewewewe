---------------------------------------------------------------- auto-accept incoming trade requests + BEG bot
local B={running=false,asked=0,accepted=0,hops=0,done={},target=nil,status="stopped",lastEvt=-1e9}
function B.setStatus(t) B.status=tostring(t) end
function B.inTrade() return false end   -- replaced below once the trade reader exists
do
	local function dig(r,...) for _,n in ipairs({...}) do r=r and r:FindFirstChild(n) end return r end
	local function findAccept(root)
		if root:IsA("GuiButton") then return root end
		for _,d in ipairs(root:GetDescendants()) do
			if d:IsA("GuiButton") then
				local t=d:IsA("TextButton") and d.Text:lower() or ""
				if d.Name:lower():find("accept") or t:find("accept") then return d end
			end
		end
	end
	-- fires ONLY the button's own click handlers: no mouse movement, no fake input, nothing else on screen is touched
	local function press(b,downFirst)
		local n=0
		pcall(function()
			if not b:IsA("GuiButton") then return end
			local s=downFirst and {b.MouseButton1Down,b.MouseButton1Up,b.MouseButton1Click,b.Activated} or {b.MouseButton1Click,b.Activated,b.MouseButton1Down,b.MouseButton1Up}
			for _,sg in ipairs(s) do for _,c in ipairs(getconnections(sg)) do pcall(function() c:Fire() end); n=n+1 end end
		end)
		return n
	end
	task.spawn(function()
		local handled=false
		while alive do
			task.wait(.1)
			pcall(function()
				local req=dig(PG,"MainGUI","Game","Leaderboard","Container","TradeRequest","ReceivingRequest")
				if (S.autoAccept or B.running) and req and req.Visible then
					if not handled then
						handled=true; task.wait(.1)
						local btn=findAccept(req)
						if btn then
							local who=dig(req,"Username")
							log("Auto-accepting trade from "..tostring(who and who.Text or "?")); press(btn)
						else log("Auto-accept: no button found under ReceivingRequest") end
					end
				else handled=false end
			end)
		end
	end)

	local DEFMSG={"a little kindness goes a long way 🥺 could you spare a small free weapon? ❤️"}
	local function messages()   -- one message per line or separated by |
		local l={}
		for m in (tostring(S.begMsgs):gsub("[\r\n]+","|")):gmatch("[^|]+") do m=trim(m); if m~="" then l[#l+1]=m end end
		return #l>0 and l or DEFMSG
	end
	local function rawSay(msg)
		local ok=pcall(function()
			if TCS.ChatVersion~=Enum.ChatVersion.TextChatService then error("legacy chat") end
			local ch=TCS.TextChannels:FindFirstChild("RBXGeneral"); if not ch then error("no general channel") end
			ch:SendAsync(msg)
		end)
		if ok then return true end
		return (pcall(function() RS:WaitForChild("DefaultChatSystemChatEvents",2).SayMessageRequest:FireServer(msg,"All") end))
	end
	-- SPAM GUARD: 4-7 s between any two messages, max 6 per minute, never the same wording twice in a row, nothing while stopped
	local lastSay,sent,lastMsg=-1e9,{},nil
	local function say(msg)
		local gap=4+math.random()*3
		while B.running and alive and os.clock()-lastSay<gap do
			if B.inTrade() then return false,"trade" end
			B.setStatus("spam guard: short pause between messages"); task.wait(.5)
		end
		while B.running and alive do
			local now,keep=os.clock(),{}
			for _,t in ipairs(sent) do if now-t<60 then keep[#keep+1]=t end end
			sent=keep
			if #sent<6 then break end
			if B.inTrade() then return false,"trade" end
			B.setStatus("spam guard: message limit reached, waiting"); task.wait(1)
		end
		if not (B.running and alive) then return false end
		if B.inTrade() then return false,"trade" end
		lastSay=os.clock(); sent[#sent+1]=lastSay
		return rawSay(msg)
	end
	local function pickMsg(l)
		if #l<=1 then return l[1] end
		local m
		repeat m=l[math.random(#l)] until m~=lastMsg
		lastMsg=m; return m
	end
	local function parts(plr)
		local c=plr and plr.Character; if not c then return nil end
		local hrp,hum=c:FindFirstChild("HumanoidRootPart"),c:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health>0 then return hrp,hum end
	end
	local function pickTarget()
		local my=parts(LP); if not my then return nil end
		local best,bd=nil,math.huge
		for _,p in ipairs(Players:GetPlayers()) do
			if p~=LP and not B.done[p.UserId] then
				local h=parts(p)
				if h then local d=(h.Position-my.Position).Magnitude if d<bd then best,bd=p,d end end
			end
		end
		return best
	end

	-- "a trade is opening" signal: trade GUI showing or a Trade remote event in the last 3 s (loops poll faster while hot)
	local function tradeHot()
		if os.clock()-B.lastEvt<3 then return true end
		local g=PG:FindFirstChild("TradeGUI")
		if g and g:IsA("ScreenGui") and g.Enabled then
			local c=g:FindFirstChild("Container")
			return c==nil or (c:IsA("GuiObject") and c.Visible)
		end
		return false
	end
	local function peekTrade()
		local _,_,p=getStatus(); if not p then return nil end
		for i=2,(p.n or 0) do
			if type(p[i])=="table" then local sd=findSides(p[i]) if sd then return sd end end
		end
	end
	-- true while a trade is open: begging (messages, walking, hopping) pauses
	function B.inTrade()
		if not S.pauseInTrade then return false end
		return peekTrade()~=nil
	end
	-- PlayerGui.TradeGUI.Container.Trade.Actions.Accept  (.Cooldown = locked, .Confirm = second stage, .Cancel never touched)
	local function acceptRoot()
		local n=PG
		for _,nm in ipairs({"TradeGUI","Container","Trade","Actions","Accept"}) do n=n and n:FindFirstChild(nm) end
		return n
	end
	local function shown(o) return o~=nil and o:IsA("GuiObject") and o.Visible end
	local function onCooldown(r) return r~=nil and shown(r:FindFirstChild("Cooldown")) end
	local function confirmShown(r) return r~=nil and shown(r:FindFirstChild("Confirm")) end
	local function isCancel(d) return d.Name:lower():find("cancel")~=nil or (d:IsA("TextButton") and d.Text:lower():find("cancel")~=nil) end
	local function clickable(o)
		if o:IsA("GuiButton") then return o end
		for _,d in ipairs(o:GetDescendants()) do
			if d:IsA("GuiButton") and not isCancel(d) then
				local n,t=d.Name:lower(),d:IsA("TextButton") and d.Text:lower() or ""
				if n:find("accept") or n:find("confirm") or t:find("accept") or t:find("confirm") then return d end
			end
		end
		return o
	end
	local function liveTrade()   -- status string ("None" = no trade) + the table that carries LastOffer
		local _,_,p=getStatus()
		if not p or not p[1] then return nil,nil end
		local data
		for i=2,(p.n or 0) do
			local v=p[i]
			if type(v)=="table" then
				if v.LastOffer~=nil then data=v break end
				for _,v2 in pairs(v) do if type(v2)=="table" and v2.LastOffer~=nil then data=v2 break end end
				if data then break end
			end
		end
		return p[2],data
	end
	-- accepts like the game does: Trade.AcceptTrade:FireServer(PlaceId*3, LastOffer); falls back to the button's own click handlers
	local function fireAccept()
		local status,data=liveTrade()
		if status=="None" then return false end
		local r=Trade:FindFirstChild("AcceptTrade")
		if r and data and data.LastOffer~=nil then
			local ok,err=pcall(function() r:FireServer(game.PlaceId*3,data.LastOffer) end)
			if not ok then log("Beg: AcceptTrade failed: "..tostring(err)) end
			return ok
		end
		local root=acceptRoot()
		if root and not onCooldown(root) then
			local btn=clickable(confirmShown(root) and root:FindFirstChild("Confirm") or root)
			local n=press(btn,true)
			log(string.format('Beg: pressed %s "%s" (%d handlers)',btn.ClassName,btn.Name,n))
			return n>0
		end
		return false
	end
	-- Accept -> Confirm. With "only accept if they do" ON, nothing is pressed until THEIR side shows Accepted.
	-- returns pressed?, newest list of their items
	local function acceptSequence()
		B.setStatus("trade open - waiting for them to accept")
		local fires,lastFire,t0,lastList=0,0,os.clock(),{}
		while B.running and alive and os.clock()-t0<40 do
			local sd=peekTrade(); if not sd then break end
			local cur=decodeOffer(sd.theirs)
			if #cur>0 then lastList=cur end
			local theyOk=(not S.onlyIfTheyAccept) or sd.theirAccepted==true
			if #cur>0 and fires<60 then
				if theyOk then
					local conf=confirmShown(acceptRoot())
					if (fires==0 or os.clock()-lastFire>=.5) and fireAccept() then
						fires=fires+1; lastFire=os.clock(); B.setStatus(conf and "they accepted - pressed Confirm" or "they accepted - pressed Accept")
					end
				else
					B.setStatus("trade open - waiting for them to accept")
				end
			end
			task.wait(.12)
		end
		return fires>0,lastList
	end
	local function waitCooldown()
		local t0=os.clock()
		while B.running and alive do
			local left=S.begCool-(os.clock()-t0)
			if left<=0 then break end
			B.setStatus(string.format("trade accepted - moving on in %d s",math.ceil(left))); task.wait(.5)
		end
	end
	local function sleepStatus(text,secs)
		local t0=os.clock()
		while B.running and alive and os.clock()-t0<secs do B.setStatus(text); task.wait(.5) end
	end

	-- random server hop with NO lookups (no HTTP, no games API): Roblox matchmaking picks the server, we only control the timing
	-- hard 45-75 s random gap between teleports + growing random backoff after failures, so Roblox never throttles us
	local Hop={busy=false,last=-1e9,fails=0}
	local function hopRandom()
		if Hop.busy then return false,"a hop is already running" end
		if B.inTrade() then return false,"in a trade - hop paused" end
		local gap,since=45+math.random()*30,os.clock()-Hop.last
		if since<gap then return false,string.format("teleport cooldown %.0f s left",gap-since) end
		Hop.busy,Hop.last=true,os.clock()
		if not queueReload() and S.autoLoad then log("Auto load: nothing queued (set a script URL / command in the BEG tab or save mm2_trade_watcher_script.lua)") end
		task.wait(.25+math.random()*1.75)
		local ok=pcall(function() TeleS:Teleport(game.PlaceId,LP) end)
		local why=ok and "random server (matchmaking)" or "teleport failed"
		if not ok then
			task.wait(2+math.random()*4)
			ok=pcall(function() TeleS:TeleportAsync(game.PlaceId,{LP}) end)
			why=ok and "random server (async)" or "teleport failed"
		end
		if ok then
			Hop.fails=0; B.hops=B.hops+1
			sendHook("Server hop",string.format("Moved to a new random server.\nAccount: **%s**\nHops this session: **%d**",MY_NAME,B.hops),3899126,true)
		else
			Hop.fails=Hop.fails+1
			why=why..string.format(" - retrying in %d s",math.ceil(math.min(30+15*Hop.fails,150)+math.random()*30))
		end
		Hop.busy=false
		return ok,why
	end
	B.testHop=hopRandom
	B.hop=hopRandom

	-- smooth per-frame glide to the spot 5 studs in front of a player, looking at them (eases out, tracks a moving target)
	local function frontGoal(h)
		local p=h.Position+h.CFrame.LookVector*5
		return p,Vector3.new(h.Position.X-p.X,0,h.Position.Z-p.Z)
	end
	local function glide(my,p,maxT)
		local t0,lp=os.clock(),0
		while B.running and alive and p.Parent and os.clock()-t0<maxT do
			local dt=math.min(RunS.Heartbeat:Wait(),.1)
			local h=parts(p); if not (h and my.Parent) then return "lost" end
			local gp,fd=frontGoal(h); local cur=my.CFrame
			local dist=(gp-cur.Position).Magnitude
			if dist<.3 then my.CFrame=CFrame.lookAt(gp,gp+(fd.Magnitude>.01 and fd or cur.LookVector)); return "arrived" end
			local cap=math.min(160,25+(os.clock()-t0)*260)
			local step=math.min(dist*(1-math.exp(-9*dt)),cap*dt); step=math.max(step,math.min(dist,5*dt))
			local pos=cur.Position:Lerp(gp,step/dist)
			local want=fd.Magnitude>.01 and fd.Unit or cur.LookVector
			local look=cur.LookVector:Lerp(want,1-math.exp(-12*dt)); look=Vector3.new(look.X,0,look.Z)
			if look.Magnitude<.01 then look=want end
			my.CFrame=CFrame.lookAt(pos,pos+look); my.AssemblyLinearVelocity=Vector3.zero
			if os.clock()-lp>.25 then lp=os.clock(); if tradeHot() and peekTrade() then return "trade" end end
		end
		return "timeout"
	end

	-- after an accepted trade: did the items really land in the inventory?  -> "ok" | "unknown" | "failed" | "partial",list
	local function verifyReceived(base,got)
		local want,offered={},0
		for _,it in ipairs(got) do want[it.dataID]=it; offered=offered+it.qty end
		local baseTotal=0
		for _,n in pairs(base) do baseTotal=baseTotal+n end
		local nWant=countKeys(want)
		local confirmed,allOk={},false
		for attempt=1,4 do
			task.wait(1.5+attempt)   -- the inventory can lag behind the trade
			if not (B.running and alive) then break end
			local ok,m,rep=pcall(detectInventory)
			if not (ok and m and rep and not rep.guiOnly) then return "unknown" end
			confirmed={}
			local nc,nowTotal=0,0
			for id,it in pairs(want) do if (m[id] or 0)>(base[id] or 0) then confirmed[id]=it; nc=nc+1 end end
			for _,n in pairs(m) do nowTotal=nowTotal+n end
			if nc==nWant then allOk=true
			elseif nc==0 and nowTotal>=baseTotal+offered then allOk=true; confirmed=want end   -- ids differ but the owned total went up
			if allOk or (nc>0 and attempt>=3) then break end
		end
		if allOk then return "ok",got end
		if next(confirmed)==nil then return "failed" end
		local r={}
		for _,it in ipairs(got) do if confirmed[it.dataID] then r[#r+1]=it end end
		return "partial",r
	end

	local function runTargetInner(p)
		B.target=p
		local msgs=messages()
		local startT,arrivedT=os.clock(),nil
		local asked,tries,wasOpen,declines=false,0,false,0   -- ONE message per person
		local base,acceptT   -- inventory before the trade (only counts if read before the first accept press)
		task.spawn(function()
			local ok,m,rep=pcall(detectInventory)
			if ok and m and rep and not rep.guiOnly and not acceptT then base=m end
		end)
		while B.running and alive do
			if not p.Parent then return "left the game" end
			local sd=peekTrade()
			-- 0) one message for THIS person (retried only if sending itself failed, max 3; never while a trade is open)
			if not asked and tries<3 and not (sd and S.pauseInTrade) then
				tries=tries+1; B.setStatus("messaging "..p.DisplayName)
				local sentOk,why=say(p.DisplayName..", "..pickMsg(msgs))
				if sentOk then asked=true elseif why=="trade" then tries=tries-1 end
			end
			-- 1) did they offer something? accept it (only once THEY accepted, if that option is on)
			if sd then wasOpen=true
			elseif wasOpen then   -- trade opened and closed with nothing taken: wait for their next request (max 3 times)
				wasOpen=false; declines=declines+1
				if declines<=3 and arrivedT then
					arrivedT=os.clock()
					B.setStatus(string.format("%s declined - waiting for another trade request",p.DisplayName))
					log("Beg: "..p.Name.." declined with no weapon - waiting for another request ("..declines.."/3)")
				end
			end
			local got=sd and decodeOffer(sd.theirs) or {}
			if sd and #got>0 then
				acceptT=acceptT or os.clock()
				local accepted,final=acceptSequence()
				if accepted then
					if final and #final>=#got then got=final end
					if base then
						B.setStatus("trade closed - checking inventory...")
						local res,list=verifyReceived(base,got)
						if res=="failed" then
							log("Beg: trade with "..tostring(sd.theirName).." finished but the items are NOT in the inventory - continuing to beg")
							B.setStatus("items not received - continuing to beg")
							return "trade failed (items not received)"
						elseif res=="partial" then log(string.format("Beg: only %d of %d offered items found in the inventory",#list,#got)); got=list
						elseif res=="unknown" then log("Beg: inventory unreadable after the trade - trusting the trade") end
					end
					B.accepted=B.accepted+1
					log("Beg: accepted a trade ("..tostring(sd.theirName)..")")
					sendHook("Trade accepted",string.format("Accepted a trade from **%s**.\nAccount: **%s**\nAccepted this session: **%d**\n\n**Items received:**\n%s",
						tostring(sd.theirName or "?"),MY_NAME,B.accepted,itemLines(got)),3899126)
					if not S.begHopTrade then waitCooldown() end
					return "traded"
				end
			end
			-- trade open: begging paused (no messages, no walking, the wait timers are frozen)
			if sd and S.pauseInTrade then
				B.setStatus("in a trade with "..tostring(sd.theirName).." - begging paused")
				local t0=os.clock(); task.wait(.2); local d=os.clock()-t0
				startT=startT+d; if arrivedT then arrivedT=arrivedT+d end
				continue
			end
			-- 2) walk to / follow them (avatar anchored while we work on this person)
			local my,hum=parts(LP); local hrp=parts(p)
			if not (my and hum and hrp) then return "lost them" end
			my.Anchored=true; hum.WalkSpeed=0; hum.JumpPower=0; pcall(function() hum.JumpHeight=0 end)
			if (my.Position-frontGoal(hrp)).Magnitude>1.5 then
				B.setStatus("moving to "..p.DisplayName); glide(my,p,3)
				if os.clock()-startT>30 and not arrivedT then return "could not reach" end
			else
				arrivedT=arrivedT or os.clock()
				pcall(function() my.CFrame=my.CFrame:Lerp(CFrame.lookAt(my.Position,Vector3.new(hrp.Position.X,my.Position.Y,hrp.Position.Z)),.45) end)
				local left=S.begWait-(os.clock()-arrivedT)
				B.setStatus(string.format("asking %s  ·  %d s left",p.DisplayName,math.max(0,math.ceil(left))))
				if left<=0 then return "no trade" end
			end
			task.wait(tradeHot() and .1 or .3)
		end
		return "stopped"
	end
	local function unlockAvatar()
		pcall(function()
			local h,hum=parts(LP)
			if h then h.Anchored=false end
			if hum then hum.WalkSpeed=B.sw or 16; hum.JumpPower=B.sj or 50; pcall(function() hum.JumpHeight=B.sh or 7.2 end) end
		end)
	end
	B.unlock=unlockAvatar
	local function runTarget(p)
		pcall(function()
			local _,hum=parts(LP)
			if hum and hum.WalkSpeed>0 then B.sw,B.sj,B.sh=hum.WalkSpeed,hum.JumpPower,hum.JumpHeight end
		end)
		local ok,res=pcall(runTargetInner,p)
		unlockAvatar()
		if not ok then log("Beg: error - "..tostring(res)); return "error" end
		return res
	end

	-- main loop
	task.spawn(function()
		local noneSince
		while alive do
			task.wait(.5)
			if B.running then
				local p=pickTarget()
				if p then
					noneSince=nil; B.done[p.UserId]=true; B.asked=B.asked+1
					local why=runTarget(p)
					log("Beg: finished with "..p.Name.." ("..tostring(why)..")"); B.target=nil
					if why=="traded" and S.begHopTrade then   -- one trade done: leave for a new random server (retry until the teleport starts)
						while B.running and alive do
							B.setStatus("trade done - hopping to a new server...")
							local ok,hw=hopRandom(); log("Hop after trade: "..tostring(hw))
							if ok then B.done={}; noneSince=nil; task.wait(5) break end
							sleepStatus("hop: "..tostring(hw),5+math.random()*10)
						end
					end
				else
					noneSince=noneSince or os.clock()
					if next(B.done) and S.begHop then   -- everyone here was asked once: new random server
						B.setStatus("everyone asked - hopping to a new server...")
						local ok,hw=hopRandom(); log("Hop (everyone asked): "..tostring(hw))
						if ok then B.done={}; noneSince=nil; task.wait(5) else sleepStatus("hop: "..tostring(hw),5+math.random()*10) end
					else
						B.setStatus("no one to ask - looking again")
						if os.clock()-noneSince>120 and next(B.done) then B.done={}; noneSince=nil end   -- HOP off: restart only after a long quiet minute
					end
					task.wait(4)
				end
			end
		end
	end)
end

---------------------------------------------------------------- WaitUntilPlayerHasLoaded (visited-server check)
-- waits for the game + your character, reads the saved list with readfile (via OldPlaceIds.read),
-- hops again if this server was already visited, otherwise saves it with writefile (via OldPlaceIds.add).
-- returns true = fresh server (saved), false = already visited (hop started) or loading was cancelled
local function WaitUntilPlayerHasLoaded()
	if not game:IsLoaded() then game.Loaded:Wait() end
	if not alive then return false end
	local w=0
	while alive and not (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character:FindFirstChildOfClass("Humanoid")) and w<30 do
		task.wait(.25); w=w+.25
	end
	if not alive then return false end
	task.wait(1)   -- let the round / lobby settle before touching anything

	local key=OldPlaceIds.key()
	if OldPlaceIds.has(key) then   -- has() calls readfile
		log("Already visited "..key.." - server hopping again")
		if S.avoidRepeat then
			local tries=0
			while alive and tries<20 do
				tries=tries+1
				local ok,why=B.hop()
				log("Hop (already visited): "..tostring(why))
				if ok then task.wait(10) return false end
				task.wait(5+math.random()*10)
			end
			log("Could not leave the visited server after 20 tries - staying")
		else
			log("Hop skipped: 'Hop away from visited servers' is OFF")
		end
		return false
	end
	local saved=OldPlaceIds.add(key)   -- writefile
	log("Saved new server "..key..(saved and "" or " (writefile unavailable - not persisted)"))
	return true
end

