task.spawn(function()
	local t = 0
	while gui.Parent do
		t = t + 0.03
		if winGrad then
			winGrad.Rotation = (t * 45) % 360
		end
		if hairGrad then
			hairGrad.Offset = Vector2.new(math.sin(t * 1.5) * 0.6, 0)
		end
		if FX.hdrSigil then
			FX.hdrSigil.Rotation = (t * 28) % 360
		end
		if FX.cardSigil then
			FX.cardSigil.Rotation = (-t * 6) % 360
		end

		if SETTINGS.horns then
			local part = hornParts[1]
			if part then
				for _, w in ipairs(part.wings) do
					w.f.Rotation = w.side * math.sin(t * 1.5) * 2.6
				end
				for _, ft in ipairs(part.feathers) do
					local w = 0.5 + 0.5 * math.sin(t * 2.6 - ft.i * 0.8)
					ft.f.BackgroundTransparency = 0.04 + 0.3 * (1 - w)
				end
				part.ringGrad.Rotation = (t * 110) % 360
				local pulse = 66 + 6 * math.sin(t * 2)
				part.aura.Size = UDim2.fromOffset(pulse, pulse)
				for i, j in ipairs(part.jewels) do
					j.BackgroundTransparency = 0.05 + 0.5 * (0.5 + 0.5 * math.sin(t * 3 - i * 0.9))
				end
				for i, g in ipairs(part.gems) do
					g.BackgroundTransparency = 0.03 + 0.3 * (0.5 + 0.5 * math.sin(t * 2.2 + i))
				end
				for _, s in ipairs(part.sparks) do
					local a = t * 1.2 + s.phase
					local sy = math.sin(a)
					s.f.Position = UDim2.fromOffset(part.cx + math.cos(a) * 104, part.cy + sy * 12 - 6)
					s.f.ZIndex = sy > 0 and 16 or 4
					s.f.BackgroundTransparency = sy > 0 and 0.1 or 0.55
				end
			end
		end

		if win.Visible and not minimized then
			for _, e in ipairs(FX.embers) do
				local p = (t * e.speed + e.phase) % 1
				local y = 1 - p
				e.f.Position = UDim2.fromScale(e.x + math.sin(t * 1.4 + e.phase * 9) * e.sway, y)
				e.f.BackgroundTransparency = 1 - 0.55 * math.sin(p * math.pi)
				e.f.Rotation = (t * 60 + e.phase * 90) % 360
			end
		end
		task.wait(1 / 30)
	end
end)

