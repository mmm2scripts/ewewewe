-- GUI Logger v3: viewer + copy + full contents of each frame
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local CONFIG = {
	Cooldown = 5,
	LogPopups = true,
	MinPopupSize = 50,
	MaxEntries = 100,
	DumpContents = true,      -- list everything inside a logged GUI
	MaxContents = 100,        -- max descendants listed per entry
	IncludeText = true,       -- show Text of labels/buttons/boxes
	SkipLayoutObjects = true, -- hide UICorner, UIListLayout, UIStroke, etc.
	UIName = "GuiLoggerUI",
	IgnoreNames = {
		["Chat"] = true,
		["BubbleChat"] = true,
		["PlayerList"] = true,
		["GuiLoggerUI"] = true,
	},
}

local VIEW_LIMIT = 15000 -- Roblox text properties cap at 16,384 characters
local setclip = setclipboard or toclipboard

